<Page
    x:Class="App_3.Views.SaleReturnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F4F6">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top bar -->
            <RowDefinition Height="Auto"/>
            <!-- Filters -->
            <RowDefinition Height="*"/>
            <!-- Table -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- TOP BAR -->
        <!-- ================================================= -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Padding="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="• Enter Business Name"
                           Foreground="#6B7280"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12">

                    <Button Content="+ Add Sale"
                            Background="#FEE2E2"
                            Foreground="#DC2626"
                            Padding="14,6"
                            CornerRadius="18"/>

                    <Button Content="+ Add Purchase"
                            Background="#DBEAFE"
                            Foreground="#2563EB"
                            Padding="14,6"
                            CornerRadius="18"/>

                    <Button Content="+"
                            Width="36"
                            Height="36"
                            CornerRadius="18"/>

                    <FontIcon Glyph="&#xE712;"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- FILTER BAR -->
        <!-- ================================================= -->
        <Border Grid.Row="1"
                Margin="16"
                Background="White"
                CornerRadius="12"
                Padding="16">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="This Month ▼"
                        Padding="14,6"
                        CornerRadius="8"/>

                <Border Grid.Column="1"
                        Background="#9CA3AF"
                        CornerRadius="4"
                        Padding="10,6">
                    <TextBlock Text="Between"
                               Foreground="White"/>
                </Border>

                <Button Grid.Column="2"
                        Content="01/01/2026   To   31/01/2026"
                        Padding="14,6"
                        CornerRadius="8"/>

                <ComboBox Grid.Column="3"
                          Width="200"
                          PlaceholderText="ALL FIRMS"/>

                <StackPanel Grid.Column="4"
                            HorizontalAlignment="Center"
                            Spacing="4">
                    <FontIcon Glyph="&#xE8EF;"/>
                    <TextBlock Text="Excel Report"
                               FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="5"
                            HorizontalAlignment="Center"
                            Spacing="4">
                    <FontIcon Glyph="&#xE749;"/>
                    <TextBlock Text="Print"
                               FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- TABLE + EMPTY STATE -->
        <!-- ================================================= -->
        <Border Grid.Row="2"
                Margin="16"
                Background="White"
                CornerRadius="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TABLE HEADER -->
                <Grid Padding="12"
                      Background="#F9FAFB"
                      BorderBrush="#E5E7EB"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="#"/>
                    <TextBlock Grid.Column="1" Text="DATE"/>
                    <TextBlock Grid.Column="2" Text="REF NO."/>
                    <TextBlock Grid.Column="3" Text="PARTY NAME"/>
                    <TextBlock Grid.Column="4" Text="CATEGORY"/>
                    <TextBlock Grid.Column="5" Text="TYPE"/>
                    <TextBlock Grid.Column="6" Text="TOTAL"/>
                    <TextBlock Grid.Column="7" Text="RECEIVED"/>
                    <TextBlock Grid.Column="8" Text="BALANCE"/>
                </Grid>

                <!-- EMPTY STATE -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="12">

                    <Ellipse Width="140"
                             Height="140"
                             Fill="#EEF2FF"/>

                    <TextBlock Text="No data is available for Credit Note."
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextAlignment="Center"/>

                    <TextBlock Text="Please try again after making relevant changes."
                               Foreground="#6B7280"
                               TextAlignment="Center"/>

                    <Button Content="+ Add Credit Note"
                            Background="#2563EB"
                            Foreground="White"
                            Padding="20,8"
                            CornerRadius="20"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- FOOTER TOTALS -->
        <!-- ================================================= -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1,0,0,0"
                Padding="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Total Amount: ₹ 0.00"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Column="1"
                           Text="Balance: ₹ 0.00"
                           HorizontalAlignment="Right"
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>

    </Grid>
</Page>
