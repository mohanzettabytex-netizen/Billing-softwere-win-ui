<Page
    x:Class="App_3.Views.SalePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F4F6">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ================= TOP BAR ================= -->
        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <StackPanel Orientation="Horizontal"
                            Spacing="16"
                            VerticalAlignment="Center">

                    <TextBlock Text="Sale"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <!-- CREDIT / CASH TOGGLE -->
                    <Border Background="#F1F5F9"
                            CornerRadius="18"
                            Padding="3">
                        <StackPanel Orientation="Horizontal">

                            <ToggleButton Content="Credit"
                                          IsChecked="{Binding IsCredit, Mode=TwoWay}"/>

                            <ToggleButton Content="Cash"
                                          IsChecked="{Binding IsCash}"/>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT ICONS -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="14"
                            VerticalAlignment="Center">
                    <SymbolIcon Symbol="Calculator"/>
                    <SymbolIcon Symbol="Setting"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= BODY ================= -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="20"
                        Spacing="22">

                <!-- ================= CUSTOMER + META ================= -->
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- CUSTOMER -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Customer *"
                                   Foreground="#2563EB"
                                   FontWeight="SemiBold"/>

                        <Border Height="40"
                                Background="White"
                                BorderBrush="#2563EB"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="10,0">
                            <Grid>
                                <TextBlock Text="Search by Name / Phone"
                                           Foreground="#9CA3AF"
                                           VerticalAlignment="Center"/>
                                <FontIcon Glyph="&#xE721;"
                                          FontFamily="Segoe MDL2 Assets"
                                          Foreground="#9CA3AF"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- PHONE -->
                    <StackPanel Grid.Column="1"
                                Spacing="6">
                        <TextBlock Text="Phone No."
                                   Foreground="#6B7280"/>

                        <Border Height="40"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,0">
                            <TextBlock Text="Phone No."
                                       Foreground="#9CA3AF"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- META -->
                    <StackPanel Grid.Column="2"
                                Spacing="10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Invoice Number"
                                       Foreground="#6B7280"/>
                            <TextBlock Text="2"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Invoice Date"
                                       Foreground="#6B7280"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                <TextBlock Text="09/01/2026"
                                           FontWeight="SemiBold"/>
                                <SymbolIcon Symbol="Calendar"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="State of supply"
                                       Foreground="#6B7280"/>

                            <Border Height="28"
                                    Width="120"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,0">
                                <Grid>
                                    <TextBlock Text="Select"
                                               Foreground="#6B7280"
                                               VerticalAlignment="Center"/>
                                    <FontIcon Glyph="&#xE70D;"
                                              FontFamily="Segoe MDL2 Assets"
                                              Foreground="#6B7280"
                                              Opacity="0.6"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ================= ITEMS TABLE ================= -->
                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel>

                        <!-- HEADER -->
                        <Grid Background="#FAFAFA"
                              Padding="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="#"/>
                            <TextBlock Grid.Column="1" Text="ITEM"/>
                            <TextBlock Grid.Column="2" Text="QTY"/>
                            <TextBlock Grid.Column="3" Text="UNIT"/>
                            <TextBlock Grid.Column="4" Text="PRICE / UNIT"/>
                            <TextBlock Grid.Column="5" Text="DISCOUNT"/>
                            <TextBlock Grid.Column="6" Text="TAX"/>
                            <FontIcon Grid.Column="7"
                                      Glyph="&#xE710;"
                                      FontFamily="Segoe MDL2 Assets"
                                      Foreground="#2563EB"
                                      HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- ================= ITEMS LIST ================= -->
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <!-- Row container -->
                                    <Border BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Background="Transparent">

                                        <Grid Padding="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- SERIAL NUMBER -->
                                            <TextBlock Text="{Binding RowNumber}"
                               VerticalAlignment="Center"/>

                                            <!-- ITEM SELECTION -->
                                            <Border Grid.Column="1"
                            Height="36"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding ItemName}"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"/>
                                                    <FontIcon Glyph="&#xE70D;"
                                      FontFamily="Segoe MDL2 Assets"
                                      HorizontalAlignment="Right"
                                      Opacity="0.5"/>
                                                </Grid>
                                            </Border>

                                            <!-- QUANTITY -->
                                            <Border Grid.Column="2"
                            Height="36"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,0">
                                                <TextBox Text="{Binding Qty, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"/>
                                            </Border>

                                            <!-- UNIT -->
                                            <Border Grid.Column="3"
                            Height="36"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,0">
                                                <TextBlock Text="{Binding Unit}"
                                   VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- PRICE -->
                                            <Border Grid.Column="4"
                            Height="36"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,0">
                                                <TextBox Text="{Binding Price, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"/>
                                            </Border>

                                            <!-- DISCOUNT -->
                                            <Border Grid.Column="5"
                            Height="36"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,0">
                                                <TextBox Text="{Binding Discount, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"/>
                                            </Border>

                                            <!-- TAX -->
                                            <Border Grid.Column="6"
                            Height="36"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,0">
                                                <TextBlock Text="{Binding Tax}"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- AMOUNT -->
                                            <TextBlock Grid.Column="7"
                               Text="{Binding Amount}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ADD ROW -->
                        <Button Content="ADD ROW"
        Click="AddRow_Click"
        Padding="12,4"
        BorderBrush="#CBD5E1"
        BorderThickness="1"
        Foreground="#2563EB"/>


                    </StackPanel>
                </Border>

                <!-- DESCRIPTION + ATTACHMENTS -->
                <StackPanel Spacing="8">
                    <Button Background="Transparent" Padding="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="#9CA3AF"/>
                            <TextBlock Text="ADD DESCRIPTION" Foreground="#9CA3AF" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Background="Transparent" Padding="4" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEB9F;" FontFamily="Segoe MDL2 Assets" Foreground="#9CA3AF"/>
                            <TextBlock Text="ADD IMAGE" Foreground="#9CA3AF" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Background="Transparent" Padding="4" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#9CA3AF"/>
                            <TextBlock Text="ADD DOCUMENT" Foreground="#9CA3AF" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= FOOTER ================= -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1,0,0,0"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <CheckBox IsChecked="True"/>
                    <TextBlock Text="Round Off"/>
                    <Border Width="60" Height="28" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                        <TextBlock Text="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Total" FontWeight="SemiBold"/>

                    <Border Width="140" Height="32" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                        <TextBlock Text="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="Share" Padding="16,6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"/>
                    <Button Content="Save"
                            Padding="22,6"
                            Background="#2563EB"
                            Foreground="White"
                            CornerRadius="6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>