<Page
    x:Class="App_3.Views.SalePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F4F6">

    <Grid RowDefinitions="Auto,*,Auto"
      Background="#F3F4F6">

        <!-- ================= TOP BAR ================= -->
        <Border Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="0,0,0,1"
            Padding="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <StackPanel Orientation="Horizontal"
                        Spacing="16"
                        VerticalAlignment="Center">

                    <TextBlock Text="Sale"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                    <!-- CREDIT / CASH -->
                    <Border Background="#F1F5F9"
                        CornerRadius="16"
                        Padding="3">

                        <StackPanel Orientation="Horizontal">

                            <Border Background="White"
                                CornerRadius="14"
                                Padding="10,2">
                                <TextBlock Text="Credit"
                                       FontWeight="SemiBold"
                                       Foreground="#2563EB"/>
                            </Border>

                            <Border Padding="10,2">
                                <TextBlock Text="Cash"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"/>
                            </Border>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT ICONS -->
                <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="16"
                        VerticalAlignment="Center">

                    <SymbolIcon Symbol="Calculator"/>
                    <SymbolIcon Symbol="Setting"/>
                    <Border Width="28"
                        Height="28"
                        Background="#2563EB"
                        CornerRadius="14">
                        <TextBlock Text="+"
                               Foreground="White"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= BODY ================= -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="20"
                    Spacing="20">

                <!-- ================= CUSTOMER + META ================= -->
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- CUSTOMER -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Customer *"
                               FontWeight="SemiBold"
                               Foreground="#2563EB"/>

                        <Border Height="40"
                            BorderBrush="#2563EB"
                            BorderThickness="2"
                            CornerRadius="6"
                            Background="White"
                            Padding="10,0">

                            <Grid>
                                <TextBlock Text="Search by Name / Phone"
                                       Foreground="#9CA3AF"
                                       VerticalAlignment="Center"/>

                                <FontIcon Glyph="&#xE711;"
                                      FontFamily="Segoe MDL2 Assets"
                                      Foreground="#9CA3AF"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- PHONE -->
                    <StackPanel Grid.Column="1"
                            Spacing="6">
                        <TextBlock Text="Phone No."
                               Foreground="#6B7280"/>

                        <Border Height="40"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="White"
                            Padding="10,0">

                            <TextBlock Text="Phone No."
                                   Foreground="#9CA3AF"
                                   VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT META -->
                    <StackPanel Grid.Column="3"
                            Spacing="10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Invoice Number"
                                   Foreground="#6B7280"/>
                            <TextBlock Text="2"
                                   Grid.Column="1"
                                   FontWeight="SemiBold"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Invoice Date"
                                   Foreground="#6B7280"/>
                            <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                <TextBlock Text="09/01/2026"
                                       FontWeight="SemiBold"/>
                                <SymbolIcon Symbol="Calendar"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="State of supply"
                                   Foreground="#6B7280"/>

                            <Border Grid.Column="1"
                                Height="32"
                                Width="120"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,0">
                                <Grid>
                                    <TextBlock Text="Select"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"/>
                                    <FontIcon Glyph="&#xE70D;"
                                          FontFamily="Segoe MDL2 Assets"
                                          Foreground="#6B7280"
                                          HorizontalAlignment="Right"
                                          Margin="0,0,4,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ================= ITEMS TABLE ================= -->
                <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel>

                        <!-- HEADER -->
                        <Grid Background="#F8FAFC"
                          Padding="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="#"/>
                            <TextBlock Grid.Column="1" Text="ITEM"/>
                            <TextBlock Grid.Column="2" Text="QTY"/>
                            <TextBlock Grid.Column="3" Text="UNIT"/>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="PRICE / UNIT"/>
                                <TextBlock Text="Without Tax"
                                       FontSize="11"
                                       Foreground="#6B7280"/>
                            </StackPanel>

                            <StackPanel Grid.Column="5">
                                <TextBlock Text="DISCOUNT"/>
                                <TextBlock Text="% / Amount"
                                       FontSize="11"
                                       Foreground="#6B7280"/>
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="TAX"/>
                                <TextBlock Text="% / Amount"
                                       FontSize="11"
                                       Foreground="#6B7280"/>
                            </StackPanel>

                            <FontIcon Grid.Column="7"
                                  Glyph="&#xE710;"
                                  FontFamily="Segoe MDL2 Assets"
                                  Foreground="#2563EB"
                                  HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- ROW 1 -->
                        <Grid Padding="12"
                          Background="#F9FAFB"
                          BorderBrush="#E5E7EB"
                          BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="1"/>

                            <Border Grid.Column="1"
                                Height="36"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,0">
                                <TextBlock Text="Select item"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"/>
                            </Border>

                            <Border Grid.Column="2" Height="36"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,0">
                                <TextBlock Text="1"/>
                            </Border>

                            <Border Grid.Column="3" Height="36"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,0">
                                <TextBlock Text="NONE"/>
                            </Border>

                            <Border Grid.Column="4" Height="36"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,0">
                                <TextBlock Text="0"/>
                            </Border>

                            <Border Grid.Column="5" Height="36"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,0">
                                <TextBlock Text="0"/>
                            </Border>

                            <Border Grid.Column="6" Height="36"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,0">
                                <TextBlock Text="Select"
                                       Foreground="#6B7280"/>
                            </Border>

                            <TextBlock Grid.Column="7"
                                   Text="0"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- ADD ROW -->
                        <Button Content="ADD ROW"
                            Margin="12"
                            Padding="14,6"
                            Background="Transparent"
                            BorderBrush="#2563EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Foreground="#2563EB"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- DESCRIPTION + ATTACHMENTS -->
                <StackPanel Spacing="10">

                    <!-- ADD DESCRIPTION -->
                    <Button Background="Transparent"
            HorizontalAlignment="Left"
            Padding="6,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE70F;"
                      FontFamily="Segoe MDL2 Assets"
                      Foreground="#9CA3AF"/>
                            <TextBlock Text="ADD DESCRIPTION"
                       Foreground="#9CA3AF"
                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- ADD IMAGE -->
                    <Button Background="Transparent"
            HorizontalAlignment="Left"
            Padding="6,4"
            IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEB9F;"
                      FontFamily="Segoe MDL2 Assets"
                      Foreground="#9CA3AF"/>
                            <TextBlock Text="ADD IMAGE"
                       Foreground="#9CA3AF"
                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- ADD DOCUMENT -->
                    <Button Background="Transparent"
            HorizontalAlignment="Left"
            Padding="6,4"
            IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A5;"
                      FontFamily="Segoe MDL2 Assets"
                      Foreground="#9CA3AF"/>
                            <TextBlock Text="ADD DOCUMENT"
                       Foreground="#9CA3AF"
                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= FOOTER ================= -->
        <Border Grid.Row="2"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1,0,0,0"
            Padding="16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                        Spacing="12">
                    <CheckBox IsChecked="True"/>
                    <TextBlock Text="Round Off"/>
                    <Border Width="60"
                        Height="32"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,0">
                        <TextBlock Text="0"/>
                    </Border>

                    <TextBlock Text="Total"
                           FontWeight="SemiBold"/>

                    <Border Width="140"
                        Height="36"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="White"
                        Padding="10,0">
                        <TextBlock Text="0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="12">
                    <Button Content="Share"
Padding="18,6"
BorderBrush="#E5E7EB"
BorderThickness="1"
CornerRadius="6">

                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <Border Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10"
            Width="220">

                                    <StackPanel Spacing="4">

                                        <!-- WHATSAPP -->
                                        <Button Background="Transparent"
                    HorizontalAlignment="Stretch"
                    Padding="8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE8BD;"
                              FontFamily="Segoe MDL2 Assets"
                              Foreground="#16A34A"/>
                                                <TextBlock Text="WhatsApp"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- WHATSAPP PDF -->
                                        <Button Background="Transparent"
                    HorizontalAlignment="Stretch"
                    Padding="8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE8BD;"
                              FontFamily="Segoe MDL2 Assets"
                              Foreground="#16A34A"/>
                                                <TextBlock Text="WhatsApp (PDF)"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- EMAIL -->
                                        <Button Background="Transparent"
                    HorizontalAlignment="Stretch"
                    Padding="8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <SymbolIcon Symbol="Mail"/>
                                                <TextBlock Text="Email"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- SMS -->
                                        <Button Background="Transparent"
                    HorizontalAlignment="Stretch"
                    Padding="8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <SymbolIcon Symbol="Message"/>
                                                <TextBlock Text="SMS"/>
                                            </StackPanel>
                                        </Button>

                                        <Rectangle Height="1"
                       Margin="6,4"
                       Fill="#E5E7EB"/>

                                        <!-- DOWNLOAD PDF -->
                                        <Button Background="Transparent"
                    HorizontalAlignment="Stretch"
                    Padding="8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <SymbolIcon Symbol="Download"/>
                                                <TextBlock Text="Download PDF"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- PRINT -->
                                        <Button Background="Transparent"
                    HorizontalAlignment="Stretch"
                    Padding="8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <SymbolIcon Symbol="Print"/>
                                                <TextBlock Text="Print"/>
                                            </StackPanel>
                                        </Button>

                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Save"/>
                    
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Page>
