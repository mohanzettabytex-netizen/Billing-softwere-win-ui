<Page
    x:Class="App_3.Views.EstimatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F5F7FA">

    <!-- ROOT LAYOUT -->
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- TOP APP BAR -->
            <RowDefinition Height="Auto"/>
            <!-- PAGE HEADER -->
            <RowDefinition Height="*"/>
            <!-- MAIN CONTENT -->
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- TOP APP BAR -->
        <!-- ================================================= -->
        <Border Grid.Row="0"
                Background="#FAFAFA"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Padding="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- BUSINESS NAME -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                    <TextBlock Text="• Enter Business Name"
                               Foreground="#6B7280"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- RIGHT ACTIONS -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12">

                    <Button Content="+ Add Sale"
                            Background="#FEE2E2"
                            Foreground="#DC2626"
                            Padding="14,6"
                            CornerRadius="18"/>

                    <Button Content="+ Add Purchase"
                            Background="#DBEAFE"
                            Foreground="#2563EB"
                            Padding="14,6"
                            CornerRadius="18"/>

                    <Button Content="+"
                            Width="36"
                            Height="36"
                            CornerRadius="18"/>

                    <FontIcon Glyph="&#xE712;"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- PAGE HEADER -->
        <!-- ================================================= -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Padding="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Estimate / Quotation"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <FontIcon Glyph="&#xE70D;" FontSize="14"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ Add Estimate"
                        Background="#EF4444"
                        Foreground="White"
                        Padding="18,6"
                        CornerRadius="18"/>
            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Padding="16" Spacing="16">

                <!-- FILTER BAR -->
                <Border Background="White"
                        CornerRadius="12"
                        Padding="14">

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Filter by :" VerticalAlignment="Center"/>

                        <Button Content="This Month ▼"
                                Padding="12,4"
                                CornerRadius="16"/>

                        <Button Content="📅 01/01/2026  To  31/01/2026"
                                Padding="12,4"
                                CornerRadius="16"/>

                        <Button Content="My Company ▼"
                                Padding="12,4"
                                CornerRadius="16"/>
                    </StackPanel>
                </Border>

                <!-- SUMMARY CARD -->
                <Border Background="#FBF5FF"
                        CornerRadius="12"
                        Padding="16"
                        Width="420">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Total Quotations"
                                       Foreground="#6B7280"/>
                            <TextBlock Text="₹ 0.00"
                                       FontSize="26"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Converted: ₹ 0.00   |   Open: ₹ 0.00"
                                       Foreground="#6B7280"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#ECFEFF"
                                CornerRadius="16"
                                Padding="8,4">
                            <TextBlock Text="0% ↑"
                                       Foreground="#0E7490"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- TRANSACTIONS / EMPTY STATE -->
                <Border Background="White"
                        CornerRadius="12"
                        Padding="24"
                        Height="420">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="12">

                        <Ellipse Width="120"
                                 Height="120"
                                 Fill="#DBEAFE"/>

                        <TextBlock Text="No Transactions to show"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>

                        <TextBlock Text="You haven't added any quotations yet."
                                   Foreground="#6B7280"
                                   TextAlignment="Center"/>

                        <Button Content="+ Add Estimate"
                                Background="#EF4444"
                                Foreground="White"
                                Padding="20,8"
                                CornerRadius="20"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
