<Page
    x:Class="App_3.Views.EstimatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:App_3.Models"
    Background="#F5F7FA">

    <!-- ROOT LAYOUT -->
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- TOP APP BAR -->
            <RowDefinition Height="Auto"/>
            <!-- PAGE HEADER -->
            <RowDefinition Height="*"/>
            <!-- MAIN CONTENT -->
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- TOP APP BAR -->
        <!-- ================================================= -->
        <Border Grid.Row="0"
                Background="#FAFAFA"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Padding="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- BUSINESS NAME -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                    <TextBlock Text="• Enter Business Name"
                               Foreground="#6B7280"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- RIGHT ACTIONS -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12">

                    <Button Content="+ Add Sale"
                            Background="#FEE2E2"
                            Foreground="#DC2626"
                            Padding="14,6"
                            CornerRadius="18"/>

                    <Button Content="+ Add Purchase"
                            Background="#DBEAFE"
                            Foreground="#2563EB"
                            Padding="14,6"
                            CornerRadius="18"/>

                    <Button Content="+"
                            Width="36"
                            Height="36"
                            CornerRadius="18"/>

                    <FontIcon Glyph="&#xE712;"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- PAGE HEADER (Estimate / Quotation + Add Estimate) -->
        <!-- ================================================= -->
        <Border Grid.Row="1"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="0,0,0,1">

            <Grid Padding="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- TITLE + DROPDOWN -->
                <Button Background="Transparent"
                BorderThickness="0"
                Padding="0">

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Estimate / Quotation"
                           FontSize="20"
                           FontWeight="SemiBold"/>
                        <FontIcon Glyph="&#xE70D;" FontSize="14"/>
                    </StackPanel>

                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">

                            <!-- SALES -->
                            <MenuFlyoutItem Text="Sale Invoices"/>
                            <MenuFlyoutItem Text="Estimate / Quotation"/>
                            <MenuFlyoutItem Text="Proforma Invoice"/>
                            <MenuFlyoutItem Text="Payment-In"/>
                            <MenuFlyoutItem Text="Sale Order"/>
                            <MenuFlyoutItem Text="Delivery Challan"/>
                            <MenuFlyoutItem Text="Sale Return"/>

                            <MenuFlyoutSeparator/>

                            <!-- PURCHASE -->
                            <MenuFlyoutItem Text="Purchase Bills"/>
                            <MenuFlyoutItem Text="Purchase Order"/>
                            <MenuFlyoutItem Text="Purchase Return"/>

                            <MenuFlyoutSeparator/>

                            <!-- OTHERS -->
                            <MenuFlyoutItem Text="Payment-Out"/>
                            <MenuFlyoutItem Text="Expenses"/>

                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- RIGHT ACTION -->
                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="12">

                    <Button Content="+ Add Estimate"
                    Background="#EF4444"
                    Foreground="White"
                    Padding="18,6"
                    CornerRadius="18"/>

                    <FontIcon Glyph="&#xE713;"
                      FontSize="18"/>
                </StackPanel>
            </Grid>
        </Border>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Padding="16" Spacing="16">

                <!-- ================================================= -->
                <!-- FILTER BAR -->
                <!-- ================================================= -->
                <Border Background="White"
        CornerRadius="12"
        Padding="14"
        BorderBrush="#E5E7EB"
        BorderThickness="1">

                    <StackPanel Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">

                        <!-- LABEL -->
                        <TextBlock Text="Filter by:"
                   FontSize="14"
                   Foreground="#374151"
                   VerticalAlignment="Center"/>

                        <!-- ESTIMATE + DATE GROUP -->
                        <Border Background="#EEF2FF"
                CornerRadius="24"
                Padding="6">

                            <StackPanel Orientation="Horizontal" Spacing="6">

                                <!-- ESTIMATE TYPE -->
                                <Button Padding="14,6"
                        CornerRadius="20"
                        Background="Transparent">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="All Estimates"/>
                                        <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                                    </StackPanel>

                                    <Button.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem Text="All Estimates"/>
                                            <MenuFlyoutItem Text="This Month"/>
                                            <MenuFlyoutItem Text="Last Month"/>
                                            <MenuFlyoutItem Text="This Quarter"/>
                                            <MenuFlyoutItem Text="This Year"/>
                                            <MenuFlyoutItem Text="Custom"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>

                                <Border Width="1"
                        Height="20"
                        Background="#CBD5E1"/>

                                <!-- DATE RANGE -->
                                <Button Padding="14,6"
                        CornerRadius="20"
                        Background="Transparent">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE787;" FontSize="14"/>
                                        <TextBlock Text="Pick a date"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </Border>

                        <!-- COMPANY -->
                        <Button Padding="14,6"
                CornerRadius="20"
                Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="My Company"/>
                                <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                            </StackPanel>

                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="All Firms"/>
                                    <MenuFlyoutItem Text="My Company"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                    </StackPanel>
                </Border>


                <!-- ================================================= -->
                <!-- SUMMARY -->
                <!-- ================================================= -->
                <Border Background="#FBF5FF"
        CornerRadius="12"
        Padding="16"
        Width="420"
        BorderBrush="#E9D5FF"
        BorderThickness="1">

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Total Estimate Amount"
                       FontSize="14"
                       Foreground="#6B7280"/>

                            <TextBlock Text="₹ 0"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#111827"/>

                            <TextBlock Text="Converted: ₹ 0   |   Open: ₹ 0"
                       FontSize="13"
                       Foreground="#6B7280"/>
                        </StackPanel>

                        <!-- PERCENT BADGE -->
                        <Border Grid.Column="1"
                Background="#ECFEFF"
                CornerRadius="14"
                Padding="8,4"
                VerticalAlignment="Top">
                            <TextBlock Text="0% ↑"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#0E7490"/>
                        </Border>
                    </Grid>
                </Border>


                <!-- TRANSACTIONS / EMPTY STATE -->
                <Border Background="White"
            CornerRadius="12"
            Padding="16"
            BorderBrush="#E5E7EB"
            BorderThickness="1">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER -->
                        <TextBlock Text="Transactions"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

                        <!-- TABLE HEADER -->
                        <!-- TABLE HEADER -->
                        <Grid Grid.Row="1"
      Background="#F9FAFB"
      Padding="10"
      ColumnSpacing="12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <!-- Date -->
                                <ColumnDefinition Width="120"/>
                                <!-- Ref -->
                                <ColumnDefinition Width="*"/>
                                <!-- Party -->
                                <ColumnDefinition Width="140"/>
                                <!-- Amount -->
                                <ColumnDefinition Width="140"/>
                                <!-- Balance -->
                                <ColumnDefinition Width="120"/>
                                <!-- Status -->
                                <ColumnDefinition Width="100"/>
                                <!-- Actions -->
                            </Grid.ColumnDefinitions>

                            <!-- DATE -->
                            <StackPanel Grid.Column="0"
Orientation="Horizontal"
Spacing="6"
VerticalAlignment="Center">

                                <!-- COLUMN TITLE -->
                                <TextBlock Text="Date"
   FontWeight="SemiBold"
   FontSize="12"
   Foreground="#374151"/>

                                <!-- FILTER BUTTON -->
                                <Button Background="Transparent"
Padding="0"
Width="20"
Height="20">

                                    <FontIcon Glyph="&#xE71C;"
      FontFamily="Segoe MDL2 Assets"
      FontSize="12"
      Foreground="#6B7280"/>

                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">

                                            <Border Background="White"
            CornerRadius="14"
            Padding="14"
            Width="280"
            BorderBrush="#E5E7EB"
            BorderThickness="1">

                                                <StackPanel Spacing="12">

                                                    <!-- FILTER TYPE -->
                                                    <TextBlock Text="Select Category"
                       FontSize="12"
                       Foreground="#6B7280"/>

                                                    <ComboBox x:Name="DateFilterType"
                      SelectedIndex="0"
                      Height="36"
                      CornerRadius="8">
                                                        <ComboBoxItem Content="Equal To"/>
                                                        <ComboBoxItem Content="Before"/>
                                                        <ComboBoxItem Content="After"/>
                                                        <ComboBoxItem Content="Between"/>
                                                    </ComboBox>

                                                    <!-- DATE PICKER -->
                                                    <TextBlock Text="Select Date"
                       FontSize="12"
                       Foreground="#6B7280"/>

                                                    <CalendarDatePicker x:Name="SalesDateFilterPicker"
                                PlaceholderText="DD/MM/YYYY"
                                Height="36"
                                CornerRadius="8"/>

                                                    <!-- ACTIONS -->
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>

                                                        <Button Content="Clear"
                        Height="36"
                        CornerRadius="18"
                        Background="#F1F5F9"
                        Foreground="#94A3B8"/>

                                                        <Button Grid.Column="1"
                        Content="Apply"
                        Height="36"
                        Margin="8,0,0,0"
                        CornerRadius="18"
                        Background="#EF4444"
                        Foreground="White"/>
                                                    </Grid>

                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>

                            <!-- REF -->
                            <StackPanel Grid.Column="1"
Orientation="Horizontal"
Spacing="6"
VerticalAlignment="Center">

                                <!-- COLUMN TITLE -->
                                <TextBlock Text="Reference no"
   FontSize="12"
   FontWeight="SemiBold"
   Foreground="#374151"/>

                                <!-- FILTER BUTTON -->
                                <Button Background="Transparent"
Padding="0"
Width="20"
Height="20">

                                    <FontIcon Glyph="&#xE71C;"
      FontFamily="Segoe MDL2 Assets"
      FontSize="12"
      Foreground="#6B7280"/>

                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">

                                            <Border Background="White"
            CornerRadius="14"
            Padding="14"
            Width="280"
            BorderBrush="#E5E7EB"
            BorderThickness="1">

                                                <StackPanel Spacing="12">

                                                    <TextBlock Text="Select Category"
                       FontSize="12"
                       Foreground="#6B7280"/>

                                                    <ComboBox SelectedIndex="0"
                      Height="36"
                      CornerRadius="8">
                                                        <ComboBoxItem Content="Contains"/>
                                                        <ComboBoxItem Content="Equals"/>
                                                        <ComboBoxItem Content="Starts With"/>
                                                        <ComboBoxItem Content="Ends With"/>
                                                    </ComboBox>

                                                    <TextBlock Text="Invoice / Ref. No"
                       FontSize="12"
                       Foreground="#6B7280"/>

                                                    <TextBox Height="36"
                     CornerRadius="8"
                     PlaceholderText="Enter invoice number"/>

                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>

                                                        <Button Content="Clear"
                        Height="36"
                        CornerRadius="18"
                        Background="#F1F5F9"
                        Foreground="#94A3B8"/>

                                                        <Button Grid.Column="1"
                        Content="Apply"
                        Height="36"
                        Margin="8,0,0,0"
                        CornerRadius="18"
                        Background="#EF4444"
                        Foreground="White"/>
                                                    </Grid>

                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>

                            <!-- PARTY -->
                            <StackPanel Grid.Column="2"
Orientation="Horizontal"
Spacing="6"
VerticalAlignment="Center">

                                <!-- COLUMN TITLE -->
                                <TextBlock Text="Party Name"
   FontSize="12"
   FontWeight="SemiBold"
   Foreground="#374151"/>

                                <!-- FILTER BUTTON -->
                                <Button Background="Transparent"
Padding="0"
Width="20"
Height="20">

                                    <FontIcon Glyph="&#xE71C;"
      FontFamily="Segoe MDL2 Assets"
      FontSize="12"
      Foreground="#6B7280"/>

                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">

                                            <Border Background="White"
            CornerRadius="14"
            Padding="14"
            Width="280"
            BorderBrush="#E5E7EB"
            BorderThickness="1">

                                                <StackPanel Spacing="12">

                                                    <TextBlock Text="Select Category"
                       FontSize="12"
                       Foreground="#6B7280"/>

                                                    <ComboBox SelectedIndex="0"
                      Height="36"
                      CornerRadius="8">
                                                        <ComboBoxItem Content="Contains"/>
                                                        <ComboBoxItem Content="Equals"/>
                                                        <ComboBoxItem Content="Starts With"/>
                                                        <ComboBoxItem Content="Ends With"/>
                                                    </ComboBox>

                                                    <TextBlock Text="Party Name"
                       FontSize="12"
                       Foreground="#6B7280"/>

                                                    <TextBox Height="36"
                     CornerRadius="8"
                     PlaceholderText="Enter party name"/>

                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>

                                                        <Button Content="Clear"
                        Height="36"
                        CornerRadius="18"
                        Background="#F1F5F9"
                        Foreground="#94A3B8"/>

                                                        <Button Grid.Column="1"
                        Content="Apply"
                        Height="36"
                        Margin="8,0,0,0"
                        CornerRadius="18"
                        Background="#EF4444"
                        Foreground="White"/>
                                                    </Grid>

                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>

                            <!-- AMOUNT -->
                            <StackPanel Grid.Column="3"
Orientation="Horizontal"
Spacing="6"
VerticalAlignment="Center">

                                <TextBlock Text="Amount"
   FontSize="12"
   FontWeight="SemiBold"
   Foreground="#374151"/>

                                <Button Background="Transparent"
Padding="0"
Width="20"
Height="20">

                                    <FontIcon Glyph="&#xE71C;"
      FontFamily="Segoe MDL2 Assets"
      FontSize="12"
      Foreground="#6B7280"/>

                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">

                                            <Border Background="White"
            CornerRadius="16"
            Padding="16"
            Width="300"
            BorderBrush="#E5E7EB"
            BorderThickness="1">

                                                <StackPanel Spacing="14">

                                                    <TextBlock Text="Price range"
                       FontSize="14"
                       FontWeight="SemiBold"/>

                                                    <!-- MIN SLIDER -->
                                                    <TextBlock Text="Minimum"
                       FontSize="12"
                       Foreground="#6B7280"/>

                                                    <Slider x:Name="MinAmountSlider"
                    Minimum="0"
                    Maximum="5000000"
                    Value="0"
                    StepFrequency="100"/>

                                                    <TextBox x:Name="MinAmountBox"
                     Height="36"
                     CornerRadius="8"
                     Text="₹0"/>

                                                    <!-- MAX SLIDER -->
                                                    <TextBlock Text="Maximum"
                       FontSize="12"
                       Foreground="#6B7280"/>

                                                    <Slider x:Name="MaxAmountSlider"
                    Minimum="0"
                    Maximum="5000000"
                    Value="5000000"
                    StepFrequency="100"/>

                                                    <TextBox x:Name="MaxAmountBox"
                     Height="36"
                     CornerRadius="8"
                     Text="₹5000000+"/>

                                                    <!-- ACTIONS -->
                                                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10"
                        Margin="0,6,0,0">

                                                        <Button Content="Clear"
                        Padding="14,6"
                        CornerRadius="18"
                        Background="#F1F5F9"
                        Foreground="#94A3B8"/>

                                                        <Button Content="Apply"
                        Padding="14,6"
                        CornerRadius="18"
                        Background="#EF4444"
                        Foreground="White"/>
                                                    </StackPanel>

                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>

                            <!-- BALANCE -->
                            <StackPanel Grid.Column="4"
Orientation="Horizontal"
Spacing="6"
VerticalAlignment="Center">

                                <!-- COLUMN TITLE -->
                                <TextBlock Text="Balance"
   FontSize="12"
   FontWeight="SemiBold"
   Foreground="#374151"/>

                                <!-- FILTER BUTTON -->
                                <Button Background="Transparent"
Padding="0"
Width="20"
Height="20">

                                    <FontIcon Glyph="&#xE71C;"
      FontFamily="Segoe MDL2 Assets"
      FontSize="12"
      Foreground="#6B7280"/>

                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">

                                            <Border Background="White"
            CornerRadius="16"
            Padding="16"
            Width="300"
            BorderBrush="#E5E7EB"
            BorderThickness="1">

                                                <StackPanel Spacing="14">

                                                    <!-- TITLE -->
                                                    <TextBlock Text="Balance range"
                       FontSize="14"
                       FontWeight="SemiBold"/>

                                                    <!-- MIN BALANCE -->
                                                    <TextBlock Text="Minimum"
                       FontSize="12"
                       Foreground="#6B7280"/>

                                                    <Slider x:Name="MinBalanceSlider"
                    Minimum="0"
                    Maximum="5000000"
                    Value="0"
                    StepFrequency="100"/>

                                                    <TextBox x:Name="MinBalanceBox"
                     Height="36"
                     CornerRadius="8"
                     Text="₹0"/>

                                                    <!-- MAX BALANCE -->
                                                    <TextBlock Text="Maximum"
                       FontSize="12"
                       Foreground="#6B7280"/>

                                                    <Slider x:Name="MaxBalanceSlider"
                    Minimum="0"
                    Maximum="5000000"
                    Value="5000000"
                    StepFrequency="100"/>

                                                    <TextBox x:Name="MaxBalanceBox"
                     Height="36"
                     CornerRadius="8"
                     Text="₹5000000+"/>

                                                    <!-- ACTIONS -->
                                                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10"
                        Margin="0,6,0,0">

                                                        <Button Content="Clear"
                        Padding="14,6"
                        CornerRadius="18"
                        Background="#F1F5F9"
                        Foreground="#94A3B8"/>

                                                        <Button Content="Apply"
                        Padding="14,6"
                        CornerRadius="18"
                        Background="#EF4444"
                        Foreground="White"/>
                                                    </StackPanel>

                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>

                            <!-- STATUS -->
                            <StackPanel Grid.Column="5"
            Orientation="Horizontal"
            Spacing="6"
            VerticalAlignment="Center">

                                <TextBlock Text="Status"
               FontSize="12"
FontWeight="SemiBold"
Foreground="#374151"/>

                                <!-- FILTER ICON -->
                                <Button Background="Transparent"
            Padding="0"
            Width="20"
            Height="20">

                                    <FontIcon Glyph="&#xE71C;"
                  FontSize="12"
                  Foreground="#6B7280"/>

                                    <!-- FLYOUT (XAML ONLY) -->
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">

                                            <Border Background="White"
                        CornerRadius="14"
                        Padding="14"
                        Width="220"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                                                <StackPanel Spacing="14">

                                                    <!-- CHECKBOX OPTIONS -->
                                                    <CheckBox Content="Open"/>
                                                    <CheckBox Content="Completed"/>

                                                    <!-- ACTION BUTTONS (UI ONLY) -->
                                                    <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="10"
                                    Margin="0,6,0,0">

                                                        <Button Content="Clear"
                                    Padding="14,6"
                                    CornerRadius="18"
                                    Background="#F1F5F9"
                                    Foreground="#94A3B8"/>

                                                        <Button Content="Apply"
                                    Padding="14,6"
                                    CornerRadius="18"
                                    Background="#EF4444"
                                    Foreground="White"/>
                                                    </StackPanel>

                                                </StackPanel>
                                            </Border>

                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>

                            <!-- ACTIONS -->
                            <TextBlock Grid.Column="6"
               Text="Actions"
               FontWeight="SemiBold"/>
                        </Grid>


                        <!-- EMPTY STATE -->
                        <StackPanel x:Name="EmptyState"
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="12">

                            <Ellipse Width="120"
                         Height="120"
                         Fill="#DBEAFE"/>

                            <TextBlock Text="No Transactions to show"
                           FontSize="18"
                           FontWeight="SemiBold"/>

                            <TextBlock Text="You haven't added any estimates yet."
                           Foreground="#6B7280"/>

                            <Button Content="+ Add Estimate"
                        Padding="20,8"
                        CornerRadius="20"
                        Background="#EF4444"
                        Foreground="White"
                        Click="AddEstimate_Click"/>
                        </StackPanel>

                        <!-- ESTIMATE LIST -->
                        <ListView x:Name="EstimateList"
                      Grid.Row="2"
                      Visibility="Collapsed"
                      SelectionMode="None">

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:EstimateModel">
                                    <Grid Padding="8"
                              ColumnSpacing="12">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{x:Bind Date}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind EstimateNo}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind PartyName}"/>
                                        <TextBlock Grid.Column="3" Text="₹ {x:Bind Amount}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind Status}"/>

                                        <TextBlock Grid.Column="5"
                                       Text="Convert ▼"
                                       Foreground="#2563EB"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
