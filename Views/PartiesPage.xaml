<Page
    x:Class="App_3.Views.PartiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F4F6">

    <!-- ROOT GRID (Global App Bar + Page Content) -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ================= TOP APP BAR (GLOBAL) ================= -->
        <Border Grid.Row="0"
                Background="#FBFBFD"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Padding="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="#EF4444"/>
                    <TextBlock Text="Enter Business Name"
                               Foreground="#9CA3AF"/>
                </StackPanel>

                <!-- Right -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12">

                    <Button Content="+ Add Sale"
                            Background="#FEE2E2"
                            Foreground="#EF4444"
                            CornerRadius="20"/>

                    <Button Content="+ Add Purchase"
                            Background="#DBEAFE"
                            Foreground="#2563EB"
                            CornerRadius="20"/>

                    <Button Content="+"
                            Width="36"
                            Height="36"
                            CornerRadius="18"/>

                    <SymbolIcon Symbol="More"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= PAGE HEADER ================= -->
        <ContentControl Grid.Row="1"
                        x:Name="PageHeader"/>

        <!-- ================= PAGE CONTENT ================= -->
        <Grid Grid.Row="2">

            <!-- EMPTY STATE -->
            <Grid x:Name="EmptyState"
                  Visibility="Visible">

                <Border Margin="12"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16"
                                Margin="20">

                        <TextBlock Text="Party Details"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Add your customers and suppliers to manage your business easily."
                                   Foreground="#6B7280"
                                   TextAlignment="Center"/>

                        <TextBlock Text="Track payments and grow your business without any hassle!"
                                   Foreground="#6B7280"
                                   TextAlignment="Center"/>

                        <!-- IMAGE PLACEHOLDER -->
                        <Border Width="260"
                                Height="200"
                                Background="#F9FAFB"
                                CornerRadius="12"
                                Margin="0,16"/>

                        <Button Content="+ Add Your First Party"
                                Padding="20,10"
                                Background="#EF4444"
                                Foreground="White"
                                CornerRadius="20"
                                HorizontalAlignment="Center"
                                Click="AddFirstParty_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- MAIN CONTENT -->
            <Grid x:Name="MainContent"
                  Visibility="Collapsed"
                  RowDefinitions="Auto,*">

                <!-- ================= PAGE HEADER ================= -->
                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1">

                    <Grid Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT : Title -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Parties"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#111827"/>

                            <FontIcon Glyph="&#xE70D;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="16"
                                      Foreground="#6B7280"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- RIGHT : Actions -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="14"
                                    VerticalAlignment="Center">

                            <Button Content="+ Add Party"
                                    Padding="18,8"
                                    Background="#EF4444"
                                    Foreground="White"
                                    CornerRadius="20"
                                    FontWeight="SemiBold"
                                    Click="OpenAddParty_Click"/>

                            <Button Width="36"
                                    Height="36"
                                    Background="Transparent">
                                <SymbolIcon Symbol="Setting"
                                            Foreground="#6B7280"/>
                            </Button>

                            <Button Width="36"
                                    Height="36"
                                    Background="Transparent">
                                <SymbolIcon Symbol="More"
                                            Foreground="#6B7280"/>
                            </Button>

                        </StackPanel>
                    </Grid>
                </Border>


                <!-- ================= MAIN CONTENT CARD ================= -->
                <Border Grid.Row="1"
                        Margin="12"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ========== LEFT PANEL ========== -->
                        <Border Grid.Column="0"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="0,0,1,0">

                            <Grid RowDefinitions="Auto,Auto,*,Auto">

                                <!-- SEARCH -->
                                <Border Padding="12">
                                    <TextBox PlaceholderText="Search Party Name"
                     Height="36"
                     CornerRadius="18"
                     Padding="14,0"/>
                                </Border>

                                <!-- HEADER -->
                                <Grid Padding="10"
              Background="#F9FAFB"
              BorderBrush="#E5E7EB"
              BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Party Name"
                       Foreground="#6B7280"
                       FontWeight="Medium"/>

                                    <!-- FILTER BUTTON -->
                                    <Button Grid.Column="1"
        Background="Transparent"
        BorderThickness="0"
        Padding="6"
        HorizontalAlignment="Right">

                                        <FontIcon Glyph="&#xE71C;"
              FontFamily="Segoe MDL2 Assets"
              Foreground="#EF4444"/>

                                        <!-- ===== FLYOUT ===== -->
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">

                                                <Border Background="White"
                    CornerRadius="12"
                    Padding="16"
                    Width="220">

                                                    <StackPanel Spacing="12">

                                                        <!-- OPTIONS -->
                                                        <CheckBox Content="All" IsChecked="True"/>
                                                        <CheckBox Content="Active"/>
                                                        <CheckBox Content="Inactive"/>
                                                        <CheckBox Content="To Receive"/>
                                                        <CheckBox Content="To Pay"/>

                                                        <!-- DIVIDER -->
                                                        <Border Height="1"
                            Background="#E5E7EB"
                            Margin="0,8"/>

                                                        <!-- ACTIONS -->
                                                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="12">

                                                            <Button Content="Clear"
                                Padding="16,6"
                                Background="#F3F4F6"
                                Foreground="#6B7280"
                                CornerRadius="18"/>

                                                            <Button Content="Apply"
                                Padding="18,6"
                                Background="#EF4444"
                                Foreground="White"
                                CornerRadius="18"/>
                                                        </StackPanel>

                                                    </StackPanel>
                                                </Border>

                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>


                                    <TextBlock Grid.Column="2"
                       Text="Amount"
                       Foreground="#6B7280"
                       FontWeight="Medium"/>
                                </Grid>

                                <!-- PARTY LIST -->
                                <ListView x:Name="PartiesList"
                  Grid.Row="2"
                  SelectionMode="Single"
                  BorderThickness="0"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

                                    <!-- SELECTED ITEM STYLE -->
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">

                                                        <!-- ROOT ELEMENT -->
                                                        <Border x:Name="RootBorder"
                            Background="Transparent">

                                                            <ContentPresenter/>

                                                            <!-- ✅ VISUAL STATES MUST BE INSIDE ROOT -->
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">

                                                                    <VisualState x:Name="Normal"/>

                                                                    <VisualState x:Name="Selected">
                                                                        <VisualState.Setters>
                                                                            <Setter Target="RootBorder.Background"
                                                Value="#D9EEF9"/>
                                                                        </VisualState.Setters>
                                                                    </VisualState>

                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>

                                                        </Border>

                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1"
                                   Text="{Binding Balance}"
                                   Foreground="#10B981"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- FOOTER CARD -->
                                <Border Grid.Row="3"
                Margin="12"
                Padding="12"
                Background="#ECFDF5"
                CornerRadius="10">

                                    <StackPanel Orientation="Horizontal"
                        Spacing="10">

                                        <FontIcon Glyph="&#xE77B;"
                          FontFamily="Segoe MDL2 Assets"
                          Foreground="#10B981"
                          FontSize="20"/>

                                        <TextBlock TextWrapping="Wrap"
                           Width="220">
                    <Run Text="Use contacts from your Phone or Gmail to "/>
                    <Run Text="quickly create parties."
                         FontWeight="SemiBold"/>
                                        </TextBlock>

                                        <FontIcon Glyph="&#xE72A;"
                          FontFamily="Segoe MDL2 Assets"
                          Foreground="#10B981"/>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </Border>


                        <!-- ========== RIGHT PANEL (VYAPAR STYLE) ========== -->
                        <Border Grid.Column="1"
        Background="White"
        CornerRadius="12"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        Margin="12">

                            <Grid RowDefinitions="Auto,Auto,Auto,*">

                                <!-- ================= PARTY HEADER ================= -->
                                <Border Padding="14"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="naveen"
                               FontSize="18"
                               FontWeight="Bold"/>
                                            <FontIcon Glyph="&#xE70F;"
                              FontFamily="Segoe MDL2 Assets"
                              Foreground="#2563EB"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="14">
                                            <FontIcon Glyph="&#xE8BD;" Foreground="#F59E0B"/>
                                            <FontIcon Glyph="&#xE717;" Foreground="#22C55E"/>
                                            <FontIcon Glyph="&#xE823;" Foreground="#3B82F6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ================= TRANSACTIONS HEADER ================= -->
                                <Grid Padding="14"
              Grid.Row="1"
              ColumnDefinitions="*,Auto">

                                    <TextBlock Text="Transactions"
                       FontSize="16"
                       FontWeight="SemiBold"/>

                                    <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="12">
                                        <FontIcon Glyph="&#xE721;" Foreground="#9CA3AF"/>
                                        <FontIcon Glyph="&#xE749;" Foreground="#9CA3AF"/>
                                        <Border Background="#EEF2FF"
                        CornerRadius="6"
                        Padding="4,2">
                                            <TextBlock Text="xls"
                               FontSize="11"
                               Foreground="#2563EB"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- ================= TABLE HEADER WITH FILTER ICONS ================= -->
                                <Grid Grid.Row="2"
      Padding="10"
      Background="#F9FAFB"
      BorderBrush="#E5E7EB"
      BorderThickness="0,0,0,1">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <!-- TYPE -->
                                    <Grid>
                                        <TextBlock Text="Type"
                   Foreground="#6B7280"/>
                                        <FontIcon Glyph="&#xE71C;"
                  FontFamily="Segoe MDL2 Assets"
                  Foreground="#9CA3AF"
                  HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- NUMBER -->
                                    <Grid Grid.Column="1">
                                        <TextBlock Text="Number"
                   Foreground="#6B7280"/>
                                        <FontIcon Glyph="&#xE71C;"
                  FontFamily="Segoe MDL2 Assets"
                  Foreground="#9CA3AF"
                  HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- DATE -->
                                    <Grid Grid.Column="2">
                                        <TextBlock Text="Date"
                   Foreground="#6B7280"/>
                                        <FontIcon Glyph="&#xE71C;"
                  FontFamily="Segoe MDL2 Assets"
                  Foreground="#9CA3AF"
                  HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- TOTAL -->
                                    <Grid Grid.Column="3">
                                        <TextBlock Text="Total"
                   Foreground="#6B7280"/>
                                        <FontIcon Glyph="&#xE71C;"
                  FontFamily="Segoe MDL2 Assets"
                  Foreground="#9CA3AF"
                  HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- BALANCE -->
                                    <Grid Grid.Column="4">
                                        <TextBlock Text="Balance"
                   Foreground="#6B7280"/>
                                        <FontIcon Glyph="&#xE71C;"
                  FontFamily="Segoe MDL2 Assets"
                  Foreground="#9CA3AF"
                  HorizontalAlignment="Right"/>
                                    </Grid>

                                </Grid>

                                <!-- ================= EMPTY STATE ================= -->
                                <StackPanel Grid.Row="3"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Margin="0,40">

                                    <Border Width="120"
                    Height="120"
                    Background="#DBEAFE"
                    CornerRadius="60"/>

                                    <TextBlock Text="No Transactions to show"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>

                                    <TextBlock Text="You haven't added any transactions yet."
                       Foreground="#6B7280"
                       TextAlignment="Center"/>
                                </StackPanel>

                            </Grid>
                        </Border>

                    </Grid>
                </Border>
            </Grid>

            <!-- ADD PARTY OVERLAY -->
            <Grid x:Name="AddPartyOverlay"
                  Visibility="Collapsed"
                  Background="#80000000"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <Border Background="White"
                        CornerRadius="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="Auto"
                        Height="Auto"
                        MaxWidth="900"
                        MaxHeight="700"
                        Margin="24">

                    <!-- MASTER GRID (Header, Content, Footer) -->
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- HEADER -->
                        <Grid Padding="20"
                              BorderBrush="#E5E7EB"
                              BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Add Party"
                                       FontSize="22"
                                       FontWeight="Bold"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="16">
                                <FontIcon Glyph="&#xE713;"
                                          FontFamily="Segoe MDL2 Assets"
                                          Foreground="#6B7280"/>
                                <Button Content="✕"
                                        Width="32"
                                        Height="32"
                                        Click="CloseAddParty_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- CONTENT HOST -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <!-- STACKED: Inputs -> Tabs -> Content -->
                            <Grid RowSpacing="12" Padding="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- inputs -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- tabs -->
                                    <RowDefinition Height="*"/>
                                    <!-- panels -->
                                </Grid.RowDefinitions>

                                <!-- TOP INPUTS -->
                                <Grid Grid.Row="0" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Party Name *" Foreground="#2563EB" Margin="2,0,0,6"/>
                                        <TextBox Height="40" HorizontalAlignment="Stretch" BorderBrush="#2563EB"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="" Height="18"/>
                                        <!-- spacer -->
                                        <TextBox Height="40" PlaceholderText="GSTIN" HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="" Height="18"/>
                                        <!-- spacer -->
                                        <TextBox Height="40" PlaceholderText="Phone Number" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>

                                <!-- TABS -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="32" Margin="0,8,0,0">
                                    <Border x:Name="GSTTab" BorderBrush="#2563EB" BorderThickness="0,0,0,3" Padding="0,0,0,6" Tapped="GSTTab_Tapped">
                                        <TextBlock x:Name="GSTTabText" Text="GST &amp; Address" FontWeight="SemiBold" Foreground="#2563EB"/>
                                    </Border>

                                    <Border x:Name="CreditTab" BorderThickness="0,0,0,3" Padding="0,0,0,6" Tapped="CreditTab_Tapped">
                                        <TextBlock x:Name="CreditTabText" Text="Credit &amp; Balance" Foreground="#9CA3AF"/>
                                    </Border>

                                    <Border x:Name="AdditionalTab" BorderThickness="0,0,0,3" Padding="0,0,0,6" Tapped="AdditionalTab_Tapped">
                                        <TextBlock x:Name="AdditionalTabText" Text="Additional Fields" Foreground="#9CA3AF"/>
                                    </Border>
                                </StackPanel>

                                <!-- CONTENT PANELS (share same outer width, only one visible) -->
                                <Grid Grid.Row="2" Margin="0,12,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <!-- narrow left column -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- main column -->
                                        <ColumnDefinition Width="220"/>
                                        <!-- right helper column -->
                                    </Grid.ColumnDefinitions>

                                    <!-- GST & ADDRESS -->
                                    <Grid x:Name="GSTContent" Visibility="Visible" Grid.ColumnSpan="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left inputs -->
                                        <StackPanel Grid.Column="0" Spacing="12" VerticalAlignment="Top">
                                            <StackPanel>
                                                <TextBlock Text="GST Type" Foreground="#6B7280" Margin="2,0,0,4"/>
                                                <ComboBox Height="40" PlaceholderText="GST Type" HorizontalAlignment="Stretch"/>
                                            </StackPanel>

                                            <StackPanel>
                                                <TextBlock Text="State" Foreground="#6B7280" Margin="2,0,0,4"/>
                                                <ComboBox Height="40" PlaceholderText="State" HorizontalAlignment="Stretch"/>
                                            </StackPanel>

                                            <StackPanel>
                                                <TextBlock Text="Email ID" Foreground="#6B7280" Margin="2,0,0,4"/>
                                                <TextBox Height="40" PlaceholderText="Email ID" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Center billing -->
                                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top" Margin="12,0">
                                            <TextBlock Text="Billing Address" FontWeight="SemiBold" Margin="2,0,0,4"/>
                                            <TextBox Height="140" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Billing Address" HorizontalAlignment="Stretch"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB"/>
                                                <TextBlock Text="Show Detailed Address" Foreground="#2563EB" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right helper -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="8,0,0,0">
                                            <TextBlock Text="Shipping Address" FontWeight="SemiBold" Margin="2,0,0,4"/>
                                            <TextBlock Text="+ Enable Shipping Address" Foreground="#2563EB" Margin="2,4,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- CREDIT & BALANCE -->
                                    <Grid x:Name="CreditContent" Visibility="Collapsed" Grid.ColumnSpan="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Opening + As of date row -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,4,0,0">
                                            <TextBlock Text="Opening Balance" Foreground="#6B7280" Margin="2,0,0,4"/>
                                            <TextBox Height="40" PlaceholderText="Opening Balance" HorizontalAlignment="Stretch"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,4,0,0">
                                            <TextBlock Text="As Of Date" Foreground="#6B7280" Margin="2,0,0,4"/>
                                            <TextBox Height="40" Text="10/01/2026" HorizontalAlignment="Stretch"/>
                                        </StackPanel>

                                        <!-- Credit limit row (span columns) -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                            <TextBlock Text="Credit Limit" FontWeight="SemiBold" Margin="2,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <TextBlock Text="No Limit" Foreground="#2563EB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <ToggleSwitch IsOn="True"/>
                                                <TextBlock Text="Custom Limit" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ADDITIONAL FIELDS -->
                                    <Grid x:Name="AdditionalContent" Visibility="Collapsed" Grid.ColumnSpan="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <!-- checkbox column -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- input column -->
                                            <ColumnDefinition Width="220"/>
                                            <!-- right helper (kept for consistent width) -->
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0 -->
                                        <CheckBox Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Height="40" PlaceholderText="Additional Field 1 Name" HorizontalAlignment="Stretch" Margin="8,4,0,0"/>

                                        <!-- Row 1 -->
                                        <CheckBox Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Height="40" PlaceholderText="Additional Field 2 Name" HorizontalAlignment="Stretch" Margin="8,4,0,0"/>

                                        <!-- Row 2 -->
                                        <CheckBox Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Height="40" PlaceholderText="Additional Field 3 Name" HorizontalAlignment="Stretch" Margin="8,4,0,0"/>

                                        <!-- Row 3 -->
                                        <CheckBox Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Grid Grid.Row="3" Grid.Column="1" Margin="8,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Height="40" PlaceholderText="Additional Field 4 Name" HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1" Height="40" PlaceholderText="dd/mm/yyyy" HorizontalAlignment="Stretch"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </ScrollViewer>

                        <!-- FOOTER -->
                        <Grid Grid.Row="2" Padding="16" BorderBrush="#E5E7EB" BorderThickness="1,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16">
                                <Button Content="Save &amp; New" Padding="24,10" BorderBrush="#2563EB" BorderThickness="2" Background="Transparent" Foreground="#2563EB"/>
                                <Button Content="Save" Padding="28,10" Background="#1D4ED8" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</Page>