<Page
    x:Class="App_3.Views.DeliveryChallanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F5F7FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="*"/>      <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- PAGE HEADER + TABS -->
        <!-- ================================================= -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <StackPanel Padding="16" Spacing="12">

                <!-- TITLE -->
                <TextBlock Text="Delivery Challan"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <!-- TABS -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- DELIVERY CHALLANS TAB -->
                    <StackPanel Grid.Column="0"
                                HorizontalAlignment="Center"
                                Spacing="6">
                        <TextBlock Text="DELIVERY CHALLANS"
                                   FontWeight="SemiBold"
                                   Foreground="#0EA5E9"/>

                        <Border Height="3"
                                Width="180"
                                Background="#0EA5E9"
                                CornerRadius="2"/>
                    </StackPanel>

                    <!-- ONLINE DELIVERY TAB -->
                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Center"
                                Spacing="6">
                        <TextBlock Text="ONLINE DELIVERY"
                                   FontWeight="SemiBold"
                                   Foreground="#9CA3AF"/>

                        <Border Height="3"
                                Width="180"
                                Background="#E5E7EB"
                                CornerRadius="2"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================================================= -->
        <!-- EMPTY STATE -->
        <!-- ================================================= -->
        <Border Grid.Row="1"
                Margin="16"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="16">

                <!-- ILLUSTRATION PLACEHOLDER -->
                <!-- Replace with Image later -->
                <Ellipse Width="160"
                         Height="160"
                         Fill="#EFF6FF"/>

                <TextBlock Text="Create delivery challans &amp; track goods delivered to customers easily."
                           TextAlignment="Center"
                           Foreground="#6B7280"
                           Width="420"
                           TextWrapping="Wrap"/>

                <Button Content="Add Your First Delivery Challan"
                        Background="#F59E0B"
                        Foreground="White"
                        Padding="24,10"
                        CornerRadius="8"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>
