<Page
    x:Class="App_3.Views.PaymentInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F5F7FA">

    <Grid>
        <!-- ================================================= -->
        <!-- MAIN CONTENT (Default View) -->
        <!-- ================================================= -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Top App Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Page Header -->
                <RowDefinition Height="*"/>
                <!-- Main Content -->
            </Grid.RowDefinitions>

            <!-- TOP APP BAR -->
            <Border Grid.Row="0"
                    Background="#FAFAFA"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <Grid Padding="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="• Enter Business Name"
                               Foreground="#6B7280"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="12">

                        <Button Content="+ Add Sale"
                                Background="#FEE2E2"
                                Foreground="#DC2626"
                                Padding="14,6"
                                CornerRadius="18"/>

                        <Button Content="+ Add Purchase"
                                Background="#DBEAFE"
                                Foreground="#2563EB"
                                Padding="14,6"
                                CornerRadius="18"/>

                        <Button Content="+"
                                Width="36"
                                Height="36"
                                CornerRadius="18"/>

                        <FontIcon Glyph="&#xE712;"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PAGE HEADER -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <Grid Padding="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Payment-In"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                        <FontIcon Glyph="&#xE70D;" FontSize="14"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="+ Add Payment-In"
                            Background="#EF4444"
                            Foreground="White"
                            Padding="18,6"
                            CornerRadius="18"
                            Click="OpenPaymentOverlay_Click"/>
                </Grid>
            </Border>

            <!-- MAIN CONTENT -->
            <ScrollViewer Grid.Row="2">
                <StackPanel Padding="16" Spacing="16">

                    <!-- FILTER BAR -->
                    <Border Background="White"
                            CornerRadius="12"
                            Padding="14">

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Filter by :" VerticalAlignment="Center"/>

                            <Button Content="This Month ▼"
                                    Padding="12,4"
                                    CornerRadius="16"/>

                            <Button Content="📅 01/01/2026  To  31/01/2026"
                                    Padding="12,4"
                                    CornerRadius="16"/>

                            <Button Content="All Firms ▼"
                                    Padding="12,4"
                                    CornerRadius="16"/>
                        </StackPanel>
                    </Border>

                    <!-- SUMMARY CARD -->
                    <Border Background="#FBF5FF"
                            CornerRadius="12"
                            Padding="16"
                            Width="420">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Total Amount"
                                           Foreground="#6B7280"/>

                                <TextBlock Text="₹ 0"
                                           FontSize="26"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Received: ₹ 0"
                                           Foreground="#6B7280"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="#ECFEFF"
                                    CornerRadius="16"
                                    Padding="8,4">
                                <TextBlock Text="0% ↑"
                                           Foreground="#0E7490"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- EMPTY STATE -->
                    <Border Background="White"
                            CornerRadius="12"
                            Padding="24"
                            Height="420">

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="12">

                            <Ellipse Width="120"
                                     Height="120"
                                     Fill="#DBEAFE"/>

                            <TextBlock Text="No Transactions to show"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>

                            <TextBlock Text="You haven't added any transactions yet."
                                       Foreground="#6B7280"
                                       TextAlignment="Center"/>

                            <Button Content="+ Add Payment-In"
                                    Background="#EF4444"
                                    Foreground="White"
                                    Padding="20,8"
                                    CornerRadius="20"
                                    Click="OpenPaymentOverlay_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= PAYMENT-IN OVERLAY ================= -->
        <Grid x:Name="PaymentOverlay"
      Visibility="Collapsed"
      Background="#80000000">

            <!-- CLICK OUTSIDE TO CLOSE -->
            <Button Background="Transparent"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Click="ClosePaymentOverlay_Click"/>

            <!-- MAIN PANEL -->
            <Border Background="White"
        CornerRadius="12"
        Padding="32"
        Margin="32"
        MaxWidth="1600"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">



                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- ================= HEADER ================= -->
                    <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Margin="0,0,0,24">

                        <TextBlock Text="Payment-In"
                           FontSize="22"
                           FontWeight="SemiBold"/>

                        <!-- RIGHT ICONS -->
                        <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16">

                            <FontIcon Glyph="&#xE8C7;" FontSize="18"/>
                            <FontIcon Glyph="&#xE713;" FontSize="18"/>

                            <Button Content="✕"
                            Width="32"
                            Height="32"
                            Background="#F3F4F6"
                            CornerRadius="16"
                            Click="ClosePaymentOverlay_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- ================= BODY ================= -->
                    <Grid Grid.Row="1"
                  ColumnSpacing="120">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT -->
                        <StackPanel Spacing="18">

                            <TextBlock Text="Party *"
                               FontWeight="SemiBold"/>

                            <ComboBox PlaceholderText="Select Party"
                              Height="44"/>

                            <TextBlock Text="Payment Type"
                               Foreground="#6B7280"/>

                            <ComboBox Height="44"
                              SelectedIndex="0">
                                <ComboBoxItem Content="Cash"/>
                                <ComboBoxItem Content="Bank"/>
                                <ComboBoxItem Content="UPI"/>
                            </ComboBox>

                            <Button Content="+ Add Payment type"
                            Background="Transparent"
                            Foreground="#2563EB"
                            HorizontalAlignment="Left"/>

                        </StackPanel>

                        <!-- RIGHT -->
                        <StackPanel Grid.Column="1"
                            Spacing="18">

                            <TextBlock Text="Receipt No"
                               Foreground="#6B7280"/>
                            <TextBox Text="1"
                             Height="44"/>

                            <TextBlock Text="Date"
                               Foreground="#6B7280"/>
                            <CalendarDatePicker Height="44"/>

                            <TextBlock Text="Received"
                               Foreground="#6B7280"/>
                            <TextBox PlaceholderText="₹ 0"
                             Height="44"/>

                        </StackPanel>

                    </Grid>

                    <!-- ================= FOOTER ================= -->
                    <Border Grid.Row="2"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    Padding="16"
                    Margin="-32,24,-32,-32">

                        <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="12">

                            <Button Content="Cancel"
                            Padding="18,8"
                            Click="ClosePaymentOverlay_Click"/>

                            <Button Content="Save"
                            Padding="22,8"
                            Background="#2563EB"
                            Foreground="White"
                            Click="SavePayment_Click"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>