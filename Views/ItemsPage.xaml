                                <!-- SEARCH ICON -->
                                <Border Width="34"
                                        Height="34"
                                        CornerRadius="17"
                                        Background="#E5E7EB"
                                        VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Find"
                                                Foreground="#374151"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                </Border>

                                <!-- ADD UNITS -->
                                <Button Grid.Column="2"
                                        Height="34"
                                        Background="#F59E0B"
                                        CornerRadius="17"
                                        Padding="14,0"
                                        FontSize="12"
                                        Click="AddUnit_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Add"
                                                    Foreground="White"
                                                    Width="14"
                                                    Height="14"/>
                                        <TextBlock Text="Add Units"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- HEADER -->
                            <Grid Padding="8,6"
                                  Background="#F1F5F9"
                                  CornerRadius="4"
                                  Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="FULLNAME"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#6B7280"/>

                                <TextBlock Grid.Column="1"
                                           Text="SHORTNAME"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#6B7280"/>
                            </Grid>

                            <!-- UNITS LIST -->
                            <ListView x:Name="UnitsList"
                                      SelectionMode="Single"
                                      HorizontalContentAlignment="Stretch">

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="Root"
                                                            Height="46"
                                                            Padding="8"
                                                            Background="Transparent"
                                                            CornerRadius="4">
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup>
                                                                <VisualState x:Name="Normal"/>
                                                                <VisualState x:Name="Selected">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="Root.Background"
                                                                                Value="#D9EEF9"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="24"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- FULL NAME -->
                                                            <TextBlock Text="{Binding FullName}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>

                                                            <!-- SHORT NAME -->
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding ShortName}"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center"/>

                                                            <!-- MORE -->
                                                            <SymbolIcon Grid.Column="2"
                                                                        Symbol="More"
                                                                        Foreground="#9CA3AF"
                                                                        VerticalAlignment="Center"
                                                                        Width="16"
                                                                        Height="16"/>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- RIGHT PANEL : UNIT CONVERSIONS -->
                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="12"
                            Padding="0">

                        <Grid RowDefinitions="Auto,*">

                            <!-- TOP HEADER -->
                            <Border Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="0,0,0,1"
                                    Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="BAGS"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="1"
                                            Height="34"
                                            Padding="14,0"
                                            Background="#2563EB"
                                            Foreground="White"
                                            CornerRadius="17"
                                            FontSize="12"
                                            Click="AddConversion_Click">
                                        Add Conversion
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- BODY -->
                            <StackPanel Grid.Row="1"
                                        Padding="14"
                                        Spacing="10">

                                <!-- UNITS HEADER + SEARCH -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="240"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="UNITS"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <!-- SEARCH -->
                                    <Grid Grid.Column="1"
                                          Height="34">
                                        <TextBox Padding="28,0,8,0"
                                                 CornerRadius="4"
                                                 FontSize="13"/>
                                        <SymbolIcon Symbol="Find"
                                                    Foreground="#6B7280"
                                                    Margin="6,0,0,0"
                                                    Width="14"
                                                    Height="14"
                                                    VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>

                                <!-- TABLE -->
                                <Border BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="6">

                                    <Grid RowDefinitions="Auto,*">

                                        <!-- TABLE HEADER -->
                                        <Grid Background="#F9FAFB"
                                              Padding="8,6"
                                              BorderBrush="#E5E7EB"
                                              BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="CONVERSION"
                                                       FontSize="11"
                                                       Foreground="#6B7280"/>
                                        </Grid>

                                        <!-- EMPTY STATE -->
                                        <Grid Grid.Row="1"
                                              MinHeight="100">
                                            <TextBlock Text="No Rows To Show"
                                                       FontSize="13"
                                                       Foreground="#6B7280"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>