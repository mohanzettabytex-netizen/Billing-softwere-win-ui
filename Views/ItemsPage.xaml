<Page
    x:Class="App_3.Views.ItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="#F3F4F6"
    NavigationCacheMode="Required">

    <Grid x:Name="RootGrid">

        <!-- ================= OVERLAY CONTAINER ================= -->
        <Grid x:Name="OverlayContainer"
              Background="#66000000"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Canvas.ZIndex="1000">

            <!-- ================= ADD UNIT OVERLAY ================= -->
            <Border x:Name="AddUnitOverlay"
                    Width="800"
                    MaxWidth="900"
                    MaxHeight="320"
                    Background="White"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Border Grid.Row="0"
                            Background="#E5EEF7"
                            CornerRadius="12,12,0,0"
                            Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="NEW UNIT"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="✕"
                                    Width="28"
                                    Height="28"
                                    FontSize="14"
                                    Background="Transparent"
                                    Foreground="#64748B"
                                    Click="CloseAddUnit_Click"
                                    HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- BODY -->
                    <Grid Grid.Row="1"
                          Padding="24"
                          ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- UNIT NAME -->
                        <StackPanel>
                            <TextBlock Text="UNIT NAME"
                                       FontSize="12"
                                       Foreground="#0284C7"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="UnitNameBox"
                                     Height="40"
                                     BorderThickness="0,0,0,2"
                                     BorderBrush="#0284C7"
                                     Background="Transparent"
                                     CornerRadius="4"
                                     Padding="8"/>
                        </StackPanel>

                        <!-- SHORT NAME -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SHORT NAME"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="UnitShortNameBox"
                                     Height="40"
                                     BorderThickness="0,0,0,1"
                                     BorderBrush="#9CA3AF"
                                     Background="Transparent"
                                     PlaceholderText="SHORTNAME"
                                     CornerRadius="4"
                                     Padding="8"/>
                        </StackPanel>
                    </Grid>

                    <!-- FOOTER -->
                    <Border Grid.Row="2"
                            Background="White"
                            CornerRadius="0,0,12,12"
                            Padding="16"
                            BorderThickness="0,1,0,0"
                            BorderBrush="#E5E7EB">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="10">

                            <Button Content="SAVE"
                                    Width="100"
                                    Height="36"
                                    Background="#0284C7"
                                    Foreground="White"
                                    CornerRadius="4"
                                    FontSize="13"
                                    Click="SaveUnit_Click"/>

                            <Button Content="SAVE NEW"
                                    Width="100"
                                    Height="36"
                                    Background="#0284C7"
                                    Foreground="White"
                                    CornerRadius="4"
                                    FontSize="13"
                                    Click="SaveNewUnit_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= ADD CONVERSION OVERLAY ================= -->
            <Border x:Name="AddConversionOverlay"
                    Width="700"
                    MaxWidth="750"
                    Background="White"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Border Grid.Row="0"
                            Background="#E0F2FE"
                            CornerRadius="12,12,0,0"
                            Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Add Conversion"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="✕"
                                    Width="28"
                                    Height="28"
                                    FontSize="14"
                                    Background="Transparent"
                                    Foreground="#64748B"
                                    Click="CloseAddConversion_Click"
                                    HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- BODY -->
                    <Grid Grid.Row="1"
                          Padding="20"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- BASE UNIT -->
                        <StackPanel>
                            <TextBlock Text="BASE UNIT"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,0,0,8"/>
                            <ComboBox Height="38"
                                      SelectedIndex="0"
                                      CornerRadius="4">
                                <ComboBoxItem Content="1 BAGS (Bag)"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- RATE -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="RATE"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,0,0,8"/>
                            <TextBox Height="38"
                                     Text="0"
                                     CornerRadius="4"
                                     Padding="8"/>
                        </StackPanel>

                        <!-- SECONDARY UNIT -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SECONDARY UNIT"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,0,0,8"/>
                            <ComboBox Height="38"
                                      CornerRadius="4">
                                <ComboBoxItem Content="None"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- FOOTER -->
                    <Border Grid.Row="2"
                            Background="White"
                            CornerRadius="0,0,12,12"
                            Padding="16"
                            BorderThickness="0,1,0,0"
                            BorderBrush="#E5E7EB">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="10">

                            <Button Content="SAVE"
                                    Width="100"
                                    Height="36"
                                    Background="#0284C7"
                                    Foreground="White"
                                    CornerRadius="4"
                                    FontSize="13"
                                    Click="SaveConversion_Click"/>

                            <Button Content="SAVE &amp; NEW"
                                    Width="120"
                                    Height="36"
                                    Background="#0284C7"
                                    Foreground="White"
                                    CornerRadius="4"
                                    FontSize="13"
                                    Click="SaveAndNewConversion_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= ADD CATEGORY OVERLAY ================= -->
            <Border x:Name="AddCategoryOverlay"
                    Width="400"
                    MaxWidth="420"
                    Background="White"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="12,12,0,0"
                            Padding="16"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Add Category"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="✕"
                                    Width="28"
                                    Height="28"
                                    FontSize="14"
                                    Background="Transparent"
                                    Foreground="#64748B"
                                    Click="CloseAddCategory_Click"
                                    HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- BODY -->
                    <StackPanel Grid.Row="1"
                                Padding="20"
                                Spacing="8">
                        <TextBlock Text="Enter Category Name"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="CategoryNameBox"
                                 Height="40"
                                 PlaceholderText="e.g. Grocery"
                                 CornerRadius="6"
                                 Padding="12"/>
                    </StackPanel>

                    <!-- FOOTER -->
                    <Border Grid.Row="2"
                            Background="White"
                            CornerRadius="0,0,12,12"
                            Padding="16"
                            BorderThickness="0,1,0,0"
                            BorderBrush="#E5E7EB">
                        <Button Content="Create"
                                Height="40"
                                Background="#E11D48"
                                Foreground="White"
                                CornerRadius="20"
                                FontWeight="SemiBold"
                                FontSize="13"
                                Click="CreateCategory_Click"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= STOCK ADJUSTMENT OVERLAY ================= -->
            <Border x:Name="StockAdjustmentOverlay"
                    Width="800"
                    MaxWidth="820"
                    MaxHeight="380"
                    Background="White"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="12,12,0,0"
                            Padding="20,20,20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                                <TextBlock Text="Stock Adjustment"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Add Stock"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#2563EB"
                                               VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="StockToggle"
                                                  IsOn="True"
                                                  MinWidth="50"
                                                  Height="24"
                                                  VerticalAlignment="Center"/>
                                    <TextBlock Text="Reduce Stock"
                                               FontSize="13"
                                               Foreground="#9CA3AF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="✕"
                                    Width="28"
                                    Height="28"
                                    Background="Transparent"
                                    FontSize="14"
                                    Foreground="#64748B"
                                    Click="CloseStockAdjustment_Click"
                                    HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- ITEM INFO -->
                    <StackPanel Grid.Row="1"
                                Margin="20,0,20,0">
                        <TextBlock Text="Item Name"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="AdjustItemName"
                                   Text="Select an item first"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- FORM -->
                    <Grid Grid.Row="2"
                          Margin="20,16,20,0"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Total Quantity"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="AdjustmentQtyTextBox"
                                     PlaceholderText="Enter quantity"
                                     Height="38"
                                     CornerRadius="6"
                                     Padding="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Price"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="AdjustmentPriceTextBox"
                                     PlaceholderText="Enter price"
                                     Height="38"
                                     CornerRadius="6"
                                     Padding="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Details"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="AdjustmentDetailsTextBox"
                                     PlaceholderText="Enter details"
                                     Height="38"
                                     CornerRadius="6"
                                     Padding="12"/>
                        </StackPanel>
                    </Grid>

                    <!-- FOOTER -->
                    <Border Grid.Row="3"
                            Background="White"
                            CornerRadius="0,0,12,12"
                            Padding="20"
                            BorderThickness="0,1,0,0"
                            BorderBrush="#E5E7EB">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Save"
                                    Width="100"
                                    Height="36"
                                    Background="#1E88F7"
                                    Foreground="White"
                                    CornerRadius="4"
                                    FontSize="13"
                                    Click="SaveStockAdjustment_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= ADD ITEM OVERLAY ================= -->
            <Border x:Name="AddItemOverlay"
                    Width="850"
                    MaxWidth="900"
                    MaxHeight="650"
                    Background="White"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="12,12,0,0"
                            Padding="16"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <TextBlock Text="Add Item"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Product"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#2563EB"
                                               VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="ItemTypeToggle"
                                                  IsOn="True"
                                                  OffContent=""
                                                  OnContent=""
                                                  MinWidth="50"
                                                  Height="24"
                                                  VerticalAlignment="Center"
                                                  Toggled="ItemTypeToggle_Toggled"/>
                                    <TextBlock Text="Service"
                                               FontSize="13"
                                               Foreground="#9CA3AF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="✕"
                                    Width="32"
                                    Height="32"
                                    Background="Transparent"
                                    FontSize="16"
                                    Foreground="#64748B"
                                    Click="CloseAddItem_Click"
                                    HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- BODY -->
                    <ScrollViewer Grid.Row="1"
                                  Padding="20"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="24">

                            <!-- PRODUCT FIELDS -->
                            <StackPanel x:Name="ProductFieldsPanel" Spacing="16">
                                <Grid ColumnSpacing="20" RowSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Item Name -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Item Name *"
                                                   FontSize="12"
                                                   Foreground="#2563EB"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>
                                        <TextBox x:Name="ItemNameTextBox"
                                                 Height="40"
                                                 CornerRadius="6"
                                                 Padding="12"/>
                                    </StackPanel>

                                    <!-- HSN -->
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="Item HSN"
                                                   FontSize="12"
                                                   Foreground="#64748B"
                                                   Margin="0,0,0,8"/>
                                        <TextBox x:Name="HsnTextBox"
                                                 Height="40"
                                                 CornerRadius="6"
                                                 Padding="12"/>
                                    </StackPanel>

                                    <!-- Select Unit -->
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Unit"
                                                   FontSize="12"
                                                   Foreground="#64748B"
                                                   Margin="0,0,0,8"/>
                                        <Button Content="Select Unit"
                                                Height="40"
                                                Background="#E0F2FE"
                                                Foreground="#0284C7"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                FontSize="13"/>
                                    </StackPanel>

                                    <!-- Category -->
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="Category"
                                                   FontSize="12"
                                                   Foreground="#64748B"
                                                   Margin="0,0,0,8"/>
                                        <ComboBox x:Name="CategoryComboBox"
                                                  Height="40"
                                                  CornerRadius="6"/>
                                    </StackPanel>

                                    <!-- Item Code -->
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="Item Code"
                                                   FontSize="12"
                                                   Foreground="#64748B"
                                                   Margin="0,0,0,8"/>
                                        <Grid>
                                            <TextBox x:Name="ItemCodeTextBox"
                                                     Height="40"
                                                     Padding="12,0,90,0"
                                                     CornerRadius="6"/>
                                            <Button Content="Assign Code"
                                                    Width="90"
                                                    Height="28"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Background="#E0F2FE"
                                                    Foreground="#0284C7"
                                                    CornerRadius="14"
                                                    FontSize="11"
                                                    Padding="0"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Add Image -->
                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Text="Item Image"
                                                   FontSize="12"
                                                   Foreground="#64748B"
                                                   Margin="0,0,0,8"/>
                                        <Button Content="Add Image"
                                                Height="40"
                                                Background="Transparent"
                                                BorderBrush="#D1D5DB"
                                                BorderThickness="1"
                                                Foreground="#2563EB"
                                                CornerRadius="6"
                                                FontSize="13"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- SERVICE FIELDS -->
                            <StackPanel x:Name="ServiceFieldsPanel"
                                        Spacing="16"
                                        Visibility="Collapsed">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Service Name *"
                                                   FontSize="12"
                                                   Foreground="#2563EB"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>
                                        <TextBox x:Name="ServiceNameTextBox"
                                                 Height="40"
                                                 CornerRadius="6"
                                                 Padding="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Service Code"
                                                   FontSize="12"
                                                   Foreground="#64748B"
                                                   Margin="0,0,0,8"/>
                                        <TextBox x:Name="ServiceCodeTextBox"
                                                 Height="40"
                                                 CornerRadius="6"
                                                 Padding="12"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- PRICING/STOCK TABS -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="24"
                                        Margin="0,8,0,0">
                                <TextBlock x:Name="PricingTab"
                                           Text="Pricing"
                                           FontWeight="SemiBold"
                                           Foreground="#DC2626"
                                           FontSize="14"
                                           Padding="0,6"
                                           Tapped="PricingTab_Tapped"/>
                                <TextBlock x:Name="StockTab"
                                           Text="Stock"
                                           FontSize="14"
                                           Foreground="#9CA3AF"
                                           Padding="0,6"
                                           Tapped="StockTab_Tapped"/>
                            </StackPanel>

                            <!-- PRICING SECTION -->
                            <Border x:Name="PricingSection"
                                    Background="#F9FAFB"
                                    CornerRadius="8"
                                    Padding="20">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Sale Price"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="SalePriceTextBox"
                                                     Height="38"
                                                     CornerRadius="6"
                                                     Padding="12"/>
                                            <ComboBox x:Name="SalePriceTaxComboBox"
                                                      Grid.Column="1"
                                                      Height="38"
                                                      CornerRadius="6"
                                                      PlaceholderText="Without Tax"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Purchase Price"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PurchasePriceTextBox"
                                                     Height="38"
                                                     CornerRadius="6"
                                                     Padding="12"/>
                                            <ComboBox x:Name="PurchasePriceTaxComboBox"
                                                      Grid.Column="1"
                                                      Height="38"
                                                      CornerRadius="6"
                                                      PlaceholderText="Without Tax"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- STOCK SECTION -->
                            <Border x:Name="StockSection"
                                    Background="#F9FAFB"
                                    CornerRadius="8"
                                    Padding="20"
                                    Visibility="Collapsed">
                                <StackPanel Spacing="12">
                                    <TextBox x:Name="OpeningQtyTextBox"
                                             PlaceholderText="Opening Quantity"
                                             Height="38"
                                             CornerRadius="6"
                                             Padding="12"/>
                                    <TextBox x:Name="AtPriceTextBox"
                                             PlaceholderText="At Price"
                                             Height="38"
                                             CornerRadius="6"
                                             Padding="12"/>
                                    <TextBox x:Name="MinStockTextBox"
                                             PlaceholderText="Minimum Stock"
                                             Height="38"
                                             CornerRadius="6"
                                             Padding="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- FOOTER -->
                    <Border Grid.Row="2"
                            Background="White"
                            CornerRadius="0,0,12,12"
                            Padding="16"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="10">
                            <Button x:Name="SaveAndNewButton"
                                    Content="Save &amp; New"
                                    Width="120"
                                    Height="36"
                                    Background="#F3F4F6"
                                    Foreground="#374151"
                                    CornerRadius="4"
                                    FontSize="13"
                                    Click="SaveAndNew_Click"/>
                            <Button x:Name="SaveButton"
                                    Content="Save"
                                    Width="100"
                                    Height="36"
                                    Background="#2563EB"
                                    Foreground="White"
                                    CornerRadius="4"
                                    FontSize="13"
                                    Click="SaveItem_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

