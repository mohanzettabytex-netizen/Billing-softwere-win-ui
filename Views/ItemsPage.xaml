<Page
    x:Class="App_3.Views.ItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Background="#F3F4F6"
    NavigationCacheMode="Enabled">

    <!-- ================= ROOT GRID ================= -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Business Header -->
            <RowDefinition Height="Auto"/>
            <!-- Tabs -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ================= BUSINESS HEADER ================= -->
        <Border Grid.Row="0"
        Background="White"
        CornerRadius="12"
        Padding="16"
        Margin="16,16,16,8">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- BUSINESS NAME AREA -->
                <StackPanel>

                    <!-- NAME + SAVE -->
                    <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8"
                        MaxWidth="520">

                        <TextBox x:Name="BusinessNameTextBox"
                         Text="Enter Business Name"
                         FontSize="20"
                         FontWeight="SemiBold"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="#0F172A"
                         MinWidth="260"
                         MaxWidth="420"
                         Padding="2,0"
                         GotFocus="BusinessNameTextBox_GotFocus"
                         LostFocus="BusinessNameTextBox_LostFocus"
                         TextChanged="BusinessNameTextBox_TextChanged">

                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0284C7"/>
                            </TextBox.Resources>
                        </TextBox>

                        <Button x:Name="SaveBusinessNameButton"
                        Content="Save"
                        Padding="14,6"
                        Background="#16A34A"
                        Foreground="White"
                        CornerRadius="6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Click="SaveBusinessName_Click"
                        Visibility="Collapsed"/>
                    </StackPanel>

                    <TextBlock Text="Billing &amp; Inventory"
                       FontSize="12"
                       Foreground="#64748B"
                       Margin="0,6,0,0"/>
                </StackPanel>

                <!-- ACTION BUTTONS -->
                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <Button Content="+ Add Sale"
                    Padding="18,6"
                    Background="#16A34A"
                    Foreground="White"
                    CornerRadius="8" Click="AddSale_Click"/>
                    <Button Content="+ Add Purchase"
                    Padding="18,6"
                    Background="#2563EB"
                    Foreground="White"
                    CornerRadius="8" Click="AddSale_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= TABS BAR ================= -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="10"
                Margin="16,0,16,8">
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
                <Border x:Name="ProductsTabBorder"
                        Background="#DBEAFE"
                        CornerRadius="8"
                        Padding="14,6"
                        Tapped="ProductsTab_Tapped">
                    <TextBlock Text="PRODUCTS"
                               FontWeight="SemiBold"
                               Foreground="#2563EB"/>
                </Border>

                <Border x:Name="ServicesTabBorder"
                        Padding="14,6"
                        CornerRadius="8"
                        Tapped="ServicesTab_Tapped">
                    <TextBlock Text="SERVICES"
                               Foreground="#64748B"/>
                </Border>

                <Border x:Name="CategoriesTabBorder"
                        Padding="14,6"
                        CornerRadius="8"
                        Tapped="CategoriesTab_Tapped">
                    <TextBlock Text="CATEGORIES"
                               Foreground="#64748B"/>
                </Border>

                <Border x:Name="UnitsTabBorder"
                        Padding="14,6"
                        CornerRadius="8"
                        Tapped="UnitsTab_Tapped">
                    <TextBlock Text="UNITS"
                               Foreground="#64748B"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ================= MAIN CONTENT (PANELS) ================= -->
        <Grid Grid.Row="2" x:Name="ContentGrid" Margin="16,0,16,16">

            <!-- ================= PRODUCTS PANEL ================= -->
            <Grid x:Name="ItemsPanel" Visibility="Visible" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Padding="8">
                    <StackPanel>
                        <!-- SEARCH -->
                        <Grid Margin="0,0,0,8">
                            <TextBox PlaceholderText="Search item"
                                     Height="40"
                                     Padding="36,0,12,0"
                                     CornerRadius="8"/>
                            <SymbolIcon Symbol="Find"
                                        Foreground="#64748B"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ADD ITEM BUTTON -->
                        <Button Content="+ Add Item"
                                Height="40"
                                Margin="0,0,0,8"
                                Background="#F59E0B"
                                Foreground="White"
                                CornerRadius="8"
                                Click="AddItem_Click"/>

                        <!-- ITEMS LISTVIEW -->
                        <ListView x:Name="ItemsList" HorizontalContentAlignment="Stretch">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Root"
                                                        Padding="8"
                                                        CornerRadius="8"
                                                        Background="Transparent">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal"/>
                                                            <VisualState x:Name="Selected">
                                                                <VisualState.Setters>
                                                                    <Setter Target="Root.Background" Value="#DBEAFE"/>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="8"
                                                Background="#E5E7EB"/>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Stock: {Binding StockQty}" 
                                                       FontSize="12" 
                                                       Foreground="#64748B"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StockQty}"
                                                   Foreground="#DC2626"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- RIGHT PANEL -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="16"
                        HorizontalAlignment="Stretch">
                    <StackPanel Spacing="14">
                        <!-- HEADER -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Item Name"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="SKU: ITM-001"
                                           FontSize="12"
                                           Foreground="#64748B"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="✏ Adjust Item"
                                    Padding="14,6"
                                    Background="#2563EB"
                                    Foreground="White"
                                    CornerRadius="8"/>
                        </Grid>

                        <!-- PRICES -->
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Sale Price"
                                           FontSize="12"
                                           Foreground="#64748B"/>
                                <TextBlock Text="₹100.00"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#16A34A"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Purchase Price"
                                           FontSize="12"
                                           Foreground="#64748B"/>
                                <TextBlock Text="₹0.00"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"/>
                            </StackPanel>
                        </Grid>

                        <!-- STOCK ALERT -->
                        <Border Background="#FEF2F2"
                                CornerRadius="8"
                                Padding="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Important" Foreground="#DC2626"/>
                                <TextBlock Text="Low Stock : 0 units remaining"
                                           Foreground="#DC2626"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- TRANSACTIONS -->
                        <TextBlock Text="TRANSACTIONS"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,4"/>

                        <Border BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <!-- TABLE HEADER -->
                                <Grid Background="#F8FAFC"
                                      Padding="8"
                                      CornerRadius="8"
                                      Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Type" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="Invoice / Name" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="Date" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text="Qty / Ref.No" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="4" Text="Price / Unit" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="5" Text="Status" FontWeight="SemiBold"/>
                                </Grid>

                                <!-- EMPTY STATE -->
                                <Border Height="180"
                                        CornerRadius="8"
                                        Background="#FFFFFF">
                                    <TextBlock Text="No transactions to show"
                                               Foreground="#94A3B8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= SERVICES PANEL ================= -->
            <Grid x:Name="ServicesPanel" Visibility="Collapsed">
                <!-- EMPTY PANEL -->
                <Grid x:Name="ServicesEmptyPanel" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="420"
                                Spacing="18">
                        <Border Width="96"
                                Height="96"
                                CornerRadius="24"
                                Background="#E0F2FE">
                            <SymbolIcon Symbol="Repair"
                                        Width="40"
                                        Height="40"
                                        Foreground="#0284C7"/>
                        </Border>

                        <TextBlock Text="No services added yet"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>

                        <TextBlock Text="Create services to start billing your customers"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <Button Content="+ Add Service"
                                Height="48"
                                Width="200"
                                Background="#0284C7"
                                Foreground="White"
                                CornerRadius="12"
                                Click="AddService_Click"/>
                    </StackPanel>
                </Grid>

                <!-- MAIN PANEL -->
                <Grid x:Name="ServicesMainPanel" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT PANEL : SERVICES LIST ================= -->
                        <Border Grid.Column="0"
                                Background="White"
                                CornerRadius="12"
                                Padding="8">
                            <StackPanel>
                                <!-- SEARCH -->
                                <Grid Margin="0,0,0,8">
                                    <TextBox PlaceholderText="Search service"
                                             Height="40"
                                             Padding="36,0,12,0"
                                             CornerRadius="8"/>
                                    <SymbolIcon Symbol="Find"
                                                Foreground="#64748B"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"/>
                                </Grid>

                                <!-- ADD SERVICE BUTTON -->
                                <Button Content="+ Add Service"
                                        Height="40"
                                        Margin="0,0,0,8"
                                       Background="#F59E0B"
                                        Foreground="White"
                                        CornerRadius="8"
                                        Click="AddService_Click"/>

                                <!-- SERVICES LIST -->
                                <ListView x:Name="ServicesListControl"
                                          HorizontalContentAlignment="Stretch">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,2"/>
                                            <Setter Property="CornerRadius" Value="8"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="Root"
                                                                Padding="8"
                                                                CornerRadius="8"
                                                                Background="Transparent">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="Normal"/>
                                                                    <VisualState x:Name="Selected">
                                                                        <VisualState.Setters>
                                                                            <Setter Target="Root.Background" Value="#E0F2FE"/>
                                                                        </VisualState.Setters>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="40"
                                                        Height="40"
                                                        CornerRadius="8"
                                                        Background="#DBEAFE"/>

                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding ServiceName}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Category}"
                                                               FontSize="12"
                                                               Foreground="#64748B"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Text="₹{Binding Rate}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0284C7"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- ================= RIGHT PANEL : SERVICE DETAILS ================= -->
                        <Border Grid.Column="1"
                                Background="White"
                                CornerRadius="12"
                                Padding="16">
                            <StackPanel Spacing="14">
                                <!-- HEADER -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Service Name"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Code: SRV-001"
                                                   FontSize="12"
                                                   Foreground="#64748B"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="✏ Edit Service"
                                            Padding="14,6"
                                            Background="#0284C7"
                                            Foreground="White"
                                            CornerRadius="8"/>
                                </Grid>

                                <!-- PRICING -->
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Service Rate"
                                                   FontSize="12"
                                                   Foreground="#64748B"/>
                                        <TextBlock Text="₹500.00"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#16A34A"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="GST"
                                                   FontSize="12"
                                                   Foreground="#64748B"/>
                                        <TextBlock Text="18%"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>

                                <!-- DESCRIPTION -->
                                <Border Background="#F8FAFC"
                                        CornerRadius="8"
                                        Padding="10">
                                    <TextBlock Text="Service description or notes can be shown here."
                                               Foreground="#475569"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- TRANSACTIONS -->
                                <TextBlock Text="SERVICE TRANSACTIONS"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,4"/>

                                <Border BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10">
                                    <StackPanel>
                                        <!-- TABLE HEADER -->
                                        <Grid Background="#F8FAFC"
                                              Padding="8"
                                              CornerRadius="8"
                                              Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Invoice" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="Customer" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="Date" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="3" Text="Amount" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold"/>
                                        </Grid>

                                        <!-- EMPTY -->
                                        <Border Height="180"
                                                CornerRadius="8">
                                            <TextBlock Text="No service transactions yet"
                                                       Foreground="#94A3B8"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================= CATEGORIES PANEL ================= -->
            <Grid x:Name="CategoriesPanel" Visibility="Collapsed" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Padding="8">
                    <StackPanel>
                        <!-- SEARCH -->
                        <Grid Margin="0,0,0,8">
                            <TextBox PlaceholderText="Search category"
                                     Height="40"
                                     Padding="36,0,12,0"
                                     CornerRadius="8"/>
                            <SymbolIcon Symbol="Find"
                                        Foreground="#64748B"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ADD CATEGORY BUTTON -->
                        <Button Content="+ Add Category"
                                Height="40"
                                Margin="0,0,0,8"
                                Background="#F59E0B"
                                Foreground="White"
                                CornerRadius="8"/>

                        <!-- CATEGORY LIST -->
                        <ListView x:Name="CategoryList" HorizontalContentAlignment="Stretch">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Root"
                                                        Padding="8"
                                                        CornerRadius="8"
                                                        Background="Transparent">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal"/>
                                                            <VisualState x:Name="Selected">
                                                                <VisualState.Setters>
                                                                    <Setter Target="Root.Background" Value="#DBEAFE"/>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="8"
                                                Background="#E5E7EB"/>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Items: {Binding ItemsCount}"
                                                       FontSize="12"
                                                       Foreground="#64748B"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ItemsCount}"
                                                   Foreground="#2563EB"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- RIGHT PANEL -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <!-- HEADER -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Category Name"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Total Items: 0"
                                           FontSize="12"
                                           Foreground="#64748B"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="✏ Move Items"
                                    Padding="14,6"
                                    Background="#2563EB"
                                    Foreground="White"
                                    CornerRadius="8"/>
                        </Grid>

                        <!-- CATEGORY ITEMS -->
                        <TextBlock Text="ITEMS IN THIS CATEGORY"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,4"/>

                        <Border BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10">
                            <StackPanel>
                                <!-- TABLE HEADER -->
                                <Grid Background="#F8FAFC"
                                      Padding="8"
                                      CornerRadius="8"
                                      Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Item Name" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="Quantity" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="Stock Value" FontWeight="SemiBold"/>
                                </Grid>

                                <!-- EMPTY STATE -->
                                <Border Height="180"
                                        CornerRadius="8"
                                        Background="#FFFFFF">
                                    <TextBlock Text="No items in this category"
                                               Foreground="#94A3B8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= UNITS PANEL ================= -->
            <Grid x:Name="UnitsPanel" Visibility="Collapsed" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Padding="8">
                    <StackPanel>
                        <!-- SEARCH -->
                        <Grid Margin="0,0,0,8">
                            <TextBox PlaceholderText="Search unit"
                                     Height="40"
                                     Padding="36,0,12,0"
                                     CornerRadius="8"/>
                            <SymbolIcon Symbol="Find"
                                        Foreground="#64748B"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ADD UNIT BUTTON -->
                        <Button Content="+ Add Unit"
                                Height="40"
                                Margin="0,0,0,8"
                                Background="#F59E0B"
                                Foreground="White"
                                CornerRadius="8"/>

                        <!-- UNITS LIST -->
                        <ListView x:Name="UnitsList" HorizontalContentAlignment="Stretch">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Root"
                                                        Padding="8"
                                                        CornerRadius="8"
                                                        Background="Transparent">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal"/>
                                                            <VisualState x:Name="Selected">
                                                                <VisualState.Setters>
                                                                    <Setter Target="Root.Background" Value="#DBEAFE"/>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="8"
                                                Background="#E0E7FF"/>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding FullName}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ShortName}"
                                                       FontSize="12"
                                                       Foreground="#64748B"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- RIGHT PANEL -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <!-- HEADER -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Kilogram"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Short name: kg"
                                           FontSize="12"
                                           Foreground="#64748B"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="+ Add Conversion"
                                    Padding="14,6"
                                    Background="#16A34A"
                                    Foreground="White"
                                    CornerRadius="8"/>
                        </Grid>

                        <!-- CONVERSIONS -->
                        <TextBlock Text="UNIT CONVERSIONS"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,4"/>

                        <Border BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10">
                            <StackPanel>
                                <!-- TABLE HEADER -->
                                <Grid Background="#F8FAFC"
                                      Padding="8"
                                      CornerRadius="8"
                                      Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Conversion Unit" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="Value" FontWeight="SemiBold"/>
                                </Grid>

                                <!-- EMPTY STATE -->
                                <Border Height="160"
                                        CornerRadius="8"
                                        Background="#FFFFFF">
                                    <TextBlock Text="No conversions added"
                                               Foreground="#94A3B8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= ADD ITEM OVERLAY ================= -->
        <Grid x:Name="AddItemOverlay"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Background="#66000000">

            <!-- CENTER DIALOG -->
            <Border Width="920"
                    MaxHeight="680"
                    Background="White"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ================= HEADER ================= -->
                    <Border Background="#F8FAFC"
                            CornerRadius="16,16,0,0"
                            Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="Add Item"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>

                                <ToggleSwitch x:Name="ItemTypeToggle"
                                              OnContent="Product"
                                              OffContent="Service"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="✕"
                                    FontSize="18"
                                    Background="Transparent"
                                    Foreground="#64748B"
                                    Padding="6"
                                    Click="CloseAddItem_Click"/>
                        </Grid>
                    </Border>

                    <!-- ================= BODY ================= -->
                    <ScrollViewer Grid.Row="1"
                                  Padding="24"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel Spacing="24">

                            <!-- ================= PRODUCT FIELDS ================= -->
                            <StackPanel x:Name="ProductFieldsPanel" Spacing="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox PlaceholderText="Item Name *"
                                             Height="42"
                                             CornerRadius="8"/>

                                    <TextBox Grid.Column="1"
                                             PlaceholderText="Item Code (Assign Code)"
                                             Height="42"
                                             CornerRadius="8"/>
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox PlaceholderText="HSN"
                                             Height="42"
                                             CornerRadius="8"/>

                                    <Button Grid.Column="1"
                                            Content="Add Item Image"
                                            Height="42"
                                            Background="#F1F5F9"
                                            CornerRadius="8"/>
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox PlaceholderText="Category"
                                              Height="42"/>

                                    <Button Grid.Column="1"
                                            Content="Select Unit"
                                            Height="42"
                                            Background="#E0F2FE"
                                            Foreground="#0284C7"
                                            CornerRadius="8"/>
                                </Grid>
                            </StackPanel>

                            <!-- ================= SERVICE FIELDS ================= -->
                            <StackPanel x:Name="ServiceFieldsPanel"
                                        Spacing="16"
                                        Visibility="Collapsed">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox PlaceholderText="Service Name *"
                                             Height="42"
                                             CornerRadius="8"/>

                                    <TextBox Grid.Column="1"
                                             PlaceholderText="Service Code"
                                             Height="42"
                                             CornerRadius="8"/>
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox PlaceholderText="SAC / HSN"
                                             Height="42"
                                             CornerRadius="8"/>

                                    <Button Grid.Column="1"
                                            Content="Select Unit"
                                            Height="42"
                                            Background="#E0F2FE"
                                            Foreground="#0284C7"
                                            CornerRadius="8"/>
                                </Grid>
                            </StackPanel>

                            <!-- ================= TABS ================= -->
                            <StackPanel Orientation="Horizontal" Spacing="28">
                                <TextBlock x:Name="PricingTab"
                                           Text="Pricing"
                                           FontWeight="SemiBold"
                                           Foreground="#DC2626"
                                           Tapped="PricingTab_Tapped"/>

                                <TextBlock x:Name="StockTab"
                                           Text="Stock"
                                           Foreground="#94A3B8"
                                           Tapped="StockTab_Tapped"/>
                            </StackPanel>

                            <!-- ================= PRICING ================= -->
                            <Border x:Name="PricingSection"
                                    Background="#F9FAFB"
                                    CornerRadius="12"
                                    Padding="20">
                                <StackPanel Spacing="20">
                                    <!-- SALE PRICE -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Sale Price" FontWeight="SemiBold"/>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="180"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox PlaceholderText="Sale Price" Height="40"/>
                                            <ComboBox Grid.Column="1"
                                                      PlaceholderText="Without Tax"
                                                      Height="40"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- PURCHASE PRICE -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Purchase Price" FontWeight="SemiBold"/>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="180"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox PlaceholderText="Purchase Price" Height="40"/>
                                            <ComboBox Grid.Column="1"
                                                      PlaceholderText="Without Tax"
                                                      Height="40"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- TAX -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Taxes" FontWeight="SemiBold"/>
                                        <Border Background="White"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox PlaceholderText="Select Tax"/>
                                                <ComboBox Grid.Column="1"
                                                          PlaceholderText="Inclusive"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ================= STOCK ================= -->
                            <Border x:Name="StockSection"
                                    Background="#F9FAFB"
                                    CornerRadius="12"
                                    Padding="20"
                                    Visibility="Collapsed">
                                <StackPanel Spacing="14">
                                    <TextBox PlaceholderText="Opening Quantity" Height="40"/>
                                    <TextBox PlaceholderText="At Price" Height="40"/>
                                    <TextBox PlaceholderText="Minimum Stock" Height="40"/>
                                    <DatePicker/>
                                    <TextBox PlaceholderText="Location" Height="40"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ================= FOOTER ================= -->
                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            CornerRadius="0,0,16,16"
                            Padding="16">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="12">
                            <Button Content="Save &amp; New"
                                    Padding="20,8"/>

                            <Button Content="Save"
                                    Padding="24,8"
                                    Background="#2563EB"
                                    Foreground="White"
                                    CornerRadius="8"
                                    Click="SaveItem_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>