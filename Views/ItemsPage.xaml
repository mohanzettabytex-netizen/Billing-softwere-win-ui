                                                    <Border x:Name="Root"
                                            Height="48"
                                            Background="Transparent"
                                            CornerRadius="4">
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup>
                                                                <VisualState x:Name="Normal"/>
                                                                <VisualState x:Name="Selected">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="Root.Background" Value="#E0F2FE"/>
